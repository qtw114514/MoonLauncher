<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoonLauncher.MainWindow"
        Title="MoonLauncher" Width="980" Height="620" MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Text}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid RowDefinitions="68,*" ClipToBounds="True">

        <!-- 背景氛围光：蓝主光 + 靛蓝辅光 -->
        <Rectangle Grid.Row="1" Fill="{StaticResource GlowGreen}" IsHitTestVisible="False"/>
        <Rectangle Grid.Row="1" Fill="{StaticResource GlowTeal}" IsHitTestVisible="False"/>

        <!-- ===== 顶栏：品牌 + 主导航胶囊 + 任务与窗口按钮 ===== -->
        <Border Grid.Row="0" Background="{StaticResource TitleBrush}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.ColumnSpan="3" Height="{StaticResource Size.Highlight.Height}"
                        VerticalAlignment="Top" Background="{StaticResource TopHighlight}"
                        IsHitTestVisible="False"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="{StaticResource Margin.Brand}" Spacing="9">
                    <Image Name="AppIcon" Width="{StaticResource Size.Brand.Icon}"
                           Height="{StaticResource Size.Brand.Icon}"
                           RenderOptions.BitmapInterpolationMode="None"/>
                    <TextBlock Text="MoonLauncher" Foreground="{StaticResource Text}"
                               FontSize="{StaticResource Font.H3}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Card}" CornerRadius="{StaticResource Radius.Small}"
                            Padding="{StaticResource Padding.Badge}" VerticalAlignment="Center">
                        <TextBlock Name="VersionTag" Foreground="{StaticResource Text2}"
                                   FontSize="{StaticResource Font.Micro}"/>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Classes="navpill" HorizontalAlignment="Center"
                        VerticalAlignment="Center" MinWidth="{StaticResource Size.Nav.GroupWidth}">
                    <UniformGrid Rows="1">
                        <RadioButton Name="NavLaunch" GroupName="nav" Classes="topnav"
                                     Content="启动" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton Name="NavDownload" GroupName="nav" Classes="topnav"
                                     Content="资源" Checked="Nav_Checked"/>
                        <RadioButton Name="NavSettings" GroupName="nav" Classes="topnav"
                                     Content="设置" Checked="Nav_Checked"/>
                        <RadioButton Name="NavMore" GroupName="nav" Classes="topnav"
                                     Content="更多" Checked="Nav_Checked"/>
                    </UniformGrid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="{StaticResource Margin.WindowButtons}" Spacing="2">
                    <Button Name="TasksButton" Classes="titleicon" Click="Tasks_Click" ToolTip.Tip="下载任务">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="{StaticResource Font.BodySmall}"/>
                    </Button>
                    <TextBlock Name="TaskCount" Foreground="{StaticResource Text2}"
                               FontSize="{StaticResource Font.Caption}"
                               VerticalAlignment="Center" Margin="2,0,6,0"/>

                    <!-- 自绘窗口按钮：macOS 保留系统红绿灯，这里按平台隐藏 -->
                    <StackPanel Name="WindowButtons" Orientation="Horizontal" Spacing="2" IsVisible="False">
                        <Button Classes="titleicon" Click="Min_Click" ToolTip.Tip="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="{StaticResource Font.Micro}"/>
                        </Button>
                        <Button Name="MaxButton" Classes="titleicon" Click="Max_Click" ToolTip.Tip="最大化">
                            <TextBlock Text="&#xE922;" FontFamily="{StaticResource Icons}" FontSize="{StaticResource Font.Micro}"/>
                        </Button>
                        <Button Classes="titleicon" Click="Close_Click" ToolTip.Tip="关闭">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="{StaticResource Font.Micro}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 页面 ===== -->
        <ContentControl Name="PageHost" Grid.Row="1" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- ===== 任务抽屉 ===== -->
        <Grid Name="TaskLayer" Grid.Row="1" IsVisible="False">
            <Border Background="{StaticResource Scrim}" PointerPressed="TaskScrim_PointerPressed"/>
            <Border HorizontalAlignment="Right" Width="{StaticResource Size.Task.DrawerWidth}"
                    Background="{StaticResource DialogSurface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,14,12,8" ColumnDefinitions="*,Auto">
                        <TextBlock Text="任务" Classes="h1" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Classes="ghost" Content="清除已完成" Click="ClearTasks_Click"/>
                            <Button Classes="ghost" Content="关闭" Click="Tasks_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Name="NoTasks" Text="暂时没有任务" Classes="sub"
                               HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    <ScrollViewer>
                        <ItemsControl Name="TaskList" Margin="14,0,14,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="taskrow">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="sub"/>
                                            </Grid>
                                            <ProgressBar Margin="0,8,0,6" Maximum="1"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                         IsVisible="{Binding IsActive}"/>
                                            <TextBlock Text="{Binding Detail}" Classes="sub"
                                                       MaxHeight="{StaticResource Size.Task.DetailMaxHeight}" Margin="0,2,0,0"/>
                                            <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="sub" VerticalAlignment="Center">
                                                    <Run Text="{Binding ProgressText, Mode=OneWay}"/>
                                                    <Run Text="  "/>
                                                    <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="暂停" Classes="ghost" Padding="6,2" Margin="3,0"
                                                            IsVisible="{Binding CanPause}" Click="PauseTask_Click"/>
                                                    <Button Content="继续" Classes="ghost" Padding="6,2" Margin="3,0"
                                                            IsVisible="{Binding CanResume}" Click="ResumeTask_Click"/>
                                                    <Button Content="重试" Classes="ghost" Padding="6,2" Margin="3,0"
                                                            IsVisible="{Binding CanRetry}" Click="RetryTask_Click"/>
                                                    <Button Content="取消" Classes="ghost" Padding="6,2" Margin="3,0"
                                                            IsVisible="{Binding CanCancel}" Click="CancelTask_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Toast ===== -->
        <Border Name="ToastBox" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="{StaticResource Margin.Toast}" Background="#EE1F2633"
                CornerRadius="{StaticResource Radius.Pill}" Padding="{StaticResource Padding.Toast}"
                IsVisible="False" IsHitTestVisible="False" MaxWidth="600">
            <TextBlock Name="ToastText" Foreground="White" FontSize="{StaticResource Font.BodySmall}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>

        <!-- ===== 对话框层 ===== -->
        <Grid Name="DialogLayer" Grid.RowSpan="2" IsVisible="False" Background="{StaticResource Scrim}">
            <ContentControl Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
