<Window x:Class="MoonLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoonLauncher" Width="980" Height="620" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="Assets/icon.png"
        StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource Size.TopBar.Height}" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Size.TopBar.Row}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="1" Fill="{DynamicResource GlowGreen}" IsHitTestVisible="False"/>
        <Rectangle Grid.Row="1" Fill="{DynamicResource GlowTeal}" IsHitTestVisible="False"/>
        <Image x:Name="BgImage" Grid.Row="1" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False"/>

        <!-- 近黑玻璃顶栏与无图标五域胶囊：资源=原 DownloadPage；下载任务=右上角任务抽屉。 -->
        <Border Background="{DynamicResource TitleBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Height="{StaticResource Size.Highlight.Height}" VerticalAlignment="Top"
                        Background="{DynamicResource TopHighlight}" IsHitTestVisible="False"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,12,0">
                    <Path Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"
                          Data="M20.6,14.4 A8.4,8.4 0 0 1 9.6,3.4 A8.4,8.4 0 1 0 20.6,14.4 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E2E9FF" Offset="0"/>
                                <GradientStop Color="#B3C2FF" Offset="0.55"/>
                                <GradientStop Color="#8192F0" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                        <Path.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.5" Color="#93A7FF"/></Path.Effect>
                    </Path>
                    <TextBlock Text="MoonLauncher" Foreground="{DynamicResource Text}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="·" Foreground="{DynamicResource TextDisabled}" FontSize="12" VerticalAlignment="Center" Margin="7,0,5,0"/>
                    <Border x:Name="VersionBadge" Background="#0BFFFFFF" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionTag" Text="v0.1" Foreground="#8E99B2" FontFamily="{StaticResource FontFamily.Mono}" FontSize="10.5"/>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource NavPill}" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="{StaticResource Size.Nav.GroupWidth}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid x:Name="NavItemsHost" SizeChanged="NavItemsHost_SizeChanged">
                        <Border x:Name="NavIndicator" Width="64" Height="30" Background="{StaticResource NavActive}"
                                BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="15"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.38" Color="#000000"/></Border.Effect>
                            <Border.RenderTransform><TranslateTransform x:Name="NavIndicatorTransform" X="1"/></Border.RenderTransform>
                        </Border>
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="NavLaunch" GroupName="nav" Style="{StaticResource TopNav}" Content="启动" Checked="Nav_Checked" AutomationProperties.Name="启动"/>
                            <RadioButton x:Name="NavDownload" GroupName="nav" Style="{StaticResource TopNav}" Content="下载" Checked="Nav_Checked" AutomationProperties.Name="下载"/>
                            <RadioButton x:Name="NavMultiplayer" GroupName="nav" Style="{StaticResource TopNav}" Content="联机" Checked="Nav_Checked" AutomationProperties.Name="联机"/>
                            <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource TopNav}" Content="设置" Checked="Nav_Checked" AutomationProperties.Name="设置"/>
                            <RadioButton x:Name="NavMore" GroupName="nav" Style="{StaticResource TopNav}" Content="更多" Checked="Nav_Checked" AutomationProperties.Name="更多"/>
                        </UniformGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="12,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="GlobalSearchBox" Width="248" Height="34" Background="#08FFFFFF" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="17" Padding="13,0" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource TextDisabled}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="GlobalSearchInput" Grid.Column="1" Style="{StaticResource InlineSearch}" Tag="全局搜索功能……"
                                     TextChanged="GlobalSearch_TextChanged" GotKeyboardFocus="GlobalSearch_Focus"
                                     LostKeyboardFocus="GlobalSearch_LostFocus" PreviewKeyDown="GlobalSearch_KeyDown"/>
                            <Border x:Name="SearchShortcut" Grid.Column="2" Background="#09FFFFFF" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="4" Padding="5,3" VerticalAlignment="Center">
                                <TextBlock Text="⌘K" FontFamily="{StaticResource FontFamily.Mono}" FontSize="10" Foreground="{DynamicResource TextDisabled}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Popup x:Name="GlobalSearchPopup" PlacementTarget="{Binding ElementName=GlobalSearchBox}" Placement="Bottom"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <Border Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                CornerRadius="12" Padding="5" Margin="0,6,8,8" Effect="{StaticResource Shadow.Dialog}">
                            <ListBox x:Name="GlobalSearchResults" Width="238" MaxHeight="260" Style="{StaticResource CardList}"
                                     Foreground="{DynamicResource Text}" PreviewMouseLeftButtonUp="GlobalSearchResults_Click"
                                     PreviewKeyDown="GlobalSearchResults_KeyDown"/>
                        </Border>
                    </Popup>
                    <Button x:Name="DownloadTasksButton" Style="{StaticResource TitleIcon}" Content="&#xE896;" Click="TasksTitle_Click"
                            ToolTip="下载任务" AutomationProperties.Name="下载任务" Visibility="Collapsed"/>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE921;" Click="Min_Click" ToolTip="最小化" AutomationProperties.Name="最小化"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleIcon}" Content="&#xE922;" Click="Max_Click" ToolTip="最大化" AutomationProperties.Name="最大化"/>
                    <Button Style="{StaticResource TitleIcon}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭"/>
                </StackPanel>
                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0093A7FF" Offset="0"/>
                            <GradientStop Color="#2493A7FF" Offset="0.22"/>
                            <GradientStop Color="#3D93A7FF" Offset="0.5"/>
                            <GradientStop Color="#2493A7FF" Offset="0.78"/>
                            <GradientStop Color="#0093A7FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <Border x:Name="ToastBox" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="{StaticResource Margin.Toast}"
                Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource BorderGradient}" BorderThickness="{StaticResource Border.Thin}"
                CornerRadius="{StaticResource Radius.Pill}" Padding="{StaticResource Padding.Toast}" Visibility="Collapsed" IsHitTestVisible="False"
                MaxWidth="{StaticResource Size.Dialog.MaxWidth}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="&#xE946;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{StaticResource Margin.IconRight}"/>
                <TextBlock x:Name="ToastText" Foreground="{DynamicResource Text}" FontSize="{StaticResource Font.BodySmall}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 下载任务抽屉：留在当前页，右侧滑出；只占内容区，不遮挡顶部标题栏；点遮罩、Esc 或关闭按钮收起；只有“查看全部任务”才进入更多域。 -->
        <Grid x:Name="TaskDrawerLayer" Grid.Row="1" Visibility="Collapsed" ClipToBounds="True">
            <Border Background="{DynamicResource Scrim}" MouseDown="TaskDrawerScrim_MouseDown"/>
            <Border x:Name="TaskDrawerPanel" HorizontalAlignment="Right" Width="{StaticResource Size.Task.DrawerWidth}"
                    MaxWidth="{Binding ActualWidth, ElementName=TaskDrawerLayer, Mode=OneWay}"
                    Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="查看全部任务" Style="{StaticResource Ghost}" MinHeight="40" Padding="8,4"
                                ToolTip="在更多页打开完整下载任务视图" Click="TaskDrawerViewAll_Click"/>
                        <Button x:Name="TaskDrawerCloseButton" Grid.Column="2" Style="{StaticResource TitleIcon}" Content="&#xE8BB;" ToolTip="关闭（Esc）"
                                AutomationProperties.Name="关闭任务抽屉" Click="TaskDrawerClose_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" VerticalAlignment="Top"/>
                    <ContentControl x:Name="TaskDrawerHost" Grid.Row="1" Focusable="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DialogLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Scrim}">
            <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
