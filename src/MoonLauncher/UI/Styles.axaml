<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Styles.Resources>
        <!-- ===== 设计令牌（与 WPF 分支一致，换色只需改这里） ===== -->
        <Color x:Key="AccentColor">#2F7BF5</Color>
        <Color x:Key="AccentHoverColor">#5493F7</Color>
        <Color x:Key="AccentPressedColor">#2560BF</Color>
        <Color x:Key="AccentSoftColor">#11274A</Color>
        <Color x:Key="AccentSoft2Color">#163667</Color>
        <Color x:Key="OnAccentColor">#0A1524</Color>
        <Color x:Key="OnAccentHoverColor">#0A1524</Color>
        <Color x:Key="OnAccentPressedColor">#FFFFFF</Color>
        <Color x:Key="SelectionGlowColor">#592F7BF5</Color>

        <Color x:Key="BackgroundColor">#0A1524</Color>
        <Color x:Key="CardColor">#13FFFFFF</Color>
        <Color x:Key="CardHoverColor">#1FFFFFFF</Color>
        <Color x:Key="SurfaceElevatedColor">#26FFFFFF</Color>
        <Color x:Key="DialogSurfaceColor">#F20E1C30</Color>
        <Color x:Key="ScrimColor">#990A1424</Color>
        <Color x:Key="LineColor">#22FFFFFF</Color>
        <Color x:Key="LineStrongColor">#40FFFFFF</Color>
        <Color x:Key="ControlBorderColor">#59FFFFFF</Color>
        <Color x:Key="TextColor">#EFF4FB</Color>
        <Color x:Key="Text2Color">#9DB2CE</Color>
        <Color x:Key="Text3Color">#7E93B0</Color>
        <Color x:Key="TextDisabledColor">#64788F</Color>
        <Color x:Key="DangerColor">#FF5A5F</Color>
        <Color x:Key="OnDangerColor">#0A1524</Color>
        <Color x:Key="DangerSoftColor">#33FF5A5F</Color>
        <Color x:Key="OkColor">#34C77B</Color>
        <Color x:Key="OnOkColor">#0A1524</Color>
        <Color x:Key="OkSoftColor">#3334C77B</Color>
        <Color x:Key="WarnColor">#FFB020</Color>
        <Color x:Key="OnWarningColor">#0A1524</Color>
        <Color x:Key="WarnSoftColor">#33FFB020</Color>
        <Color x:Key="FocusColor">#7FB2FF</Color>
        <Color x:Key="HighlightTopColor">#17FFFFFF</Color>
        <Color x:Key="ScrollThumbColor">#59FFFFFF</Color>
        <Color x:Key="ScrollThumbHoverColor">#80FFFFFF</Color>

        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}"/>
        <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}"/>
        <SolidColorBrush x:Key="AccentSoft2" Color="{StaticResource AccentSoft2Color}"/>
        <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
        <SolidColorBrush x:Key="OnAccentHover" Color="{StaticResource OnAccentHoverColor}"/>
        <SolidColorBrush x:Key="OnAccentPressed" Color="{StaticResource OnAccentPressedColor}"/>
        <SolidColorBrush x:Key="SelectionGlow" Color="{StaticResource SelectionGlowColor}"/>

        <SolidColorBrush x:Key="Bg" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="CardHover" Color="{StaticResource CardHoverColor}"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource SurfaceElevatedColor}"/>
        <SolidColorBrush x:Key="DialogSurface" Color="{StaticResource DialogSurfaceColor}"/>
        <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}"/>
        <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
        <SolidColorBrush x:Key="LineStrong" Color="{StaticResource LineStrongColor}"/>
        <SolidColorBrush x:Key="ControlBorder" Color="{StaticResource ControlBorderColor}"/>
        <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="Text2" Color="{StaticResource Text2Color}"/>
        <SolidColorBrush x:Key="Text3" Color="{StaticResource Text3Color}"/>
        <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>
        <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="OnDanger" Color="{StaticResource OnDangerColor}"/>
        <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}"/>
        <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}"/>
        <SolidColorBrush x:Key="OnOk" Color="{StaticResource OnOkColor}"/>
        <SolidColorBrush x:Key="OkSoft" Color="{StaticResource OkSoftColor}"/>
        <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
        <SolidColorBrush x:Key="OnWarning" Color="{StaticResource OnWarningColor}"/>
        <SolidColorBrush x:Key="WarnSoft" Color="{StaticResource WarnSoftColor}"/>
        <SolidColorBrush x:Key="Focus" Color="{StaticResource FocusColor}"/>
        <SolidColorBrush x:Key="ScrollThumb" Color="{StaticResource ScrollThumbColor}"/>
        <SolidColorBrush x:Key="ScrollThumbHover" Color="{StaticResource ScrollThumbHoverColor}"/>

        <!-- 边框渐变：卡片与对话框的高光描边 -->
        <LinearGradientBrush x:Key="BorderGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#E6FFFFFF" Offset="0"/>
            <GradientStop Color="#80FFFFFF" Offset="0.45"/>
            <GradientStop Color="#4D9FB4D6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopHighlight" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#17FFFFFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- 背景氛围光：蓝主光 + 靛蓝辅光（键名沿用 WPF 版，页面无需改） -->
        <RadialGradientBrush x:Key="GlowGreen" RadiusX="0.8" RadiusY="0.8" Center="15%,5%" GradientOrigin="15%,5%">
            <GradientStop Color="#332F7BF5" Offset="0"/>
            <GradientStop Color="#002F7BF5" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="GlowTeal" RadiusX="0.7" RadiusY="0.7" Center="90%,80%" GradientOrigin="90%,80%">
            <GradientStop Color="#262052C4" Offset="0"/>
            <GradientStop Color="#002052C4" Offset="1"/>
        </RadialGradientBrush>

        <!-- 新闻头图承托：深蓝黑纵向渐变，上透明下实 -->
        <LinearGradientBrush x:Key="HeroOverlay" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#730A1524" Offset="0.45"/>
            <GradientStop Color="#F20A1524" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TitleBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#F2102545" Offset="0"/>
            <GradientStop Color="#F20C1A2E" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="UiFont">Inter, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif</FontFamily>
        <FontFamily x:Key="FontFamily.Mono">Consolas, SF Mono, Menlo, Noto Sans Mono CJK SC, monospace</FontFamily>

        <!-- ===== 图标几何 =====
             原用 Segoe MDL2 Assets 的私有区码位，该字体是微软专有字体，不能随应用分发，
             且私有区码位在每个图标字体里含义不同，无法靠换字体解决。
             这里改为 16×16 网格上的自绘矢量路径，PathIcon 渲染：不依赖任何字体、
             三平台像素一致、随 Foreground 继承主题色。 -->
        <StreamGeometry x:Key="Icon.Back">M10.9,2.1 L12.4,3.5 L7.9,8 L12.4,12.5 L10.9,13.9 L5,8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Play">M4.2,2.2 L13.8,8 L4.2,13.8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Settings">M6.54,3.22 L6.38,0.98 L9.62,0.98 L9.46,3.22 L11.41,4.34 L13.27,3.09 L14.89,5.9 L12.87,6.88 L12.87,9.13 L14.89,10.11 L13.27,12.91 L11.41,11.66 L9.46,12.78 L9.62,15.02 L6.38,15.02 L6.54,12.78 L4.59,11.66 L2.73,12.91 L1.11,10.11 L3.13,9.13 L3.13,6.88 L1.11,5.9 L2.73,3.09 L4.59,4.34 Z M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Folder">M1.4,3.2 L5.9,3.2 L7.7,5.6 L14.6,5.6 L14.6,12.8 L1.4,12.8 Z M2.9,7.1 L13.1,7.1 L13.1,11.3 L2.9,11.3 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Download">F1 M8,10.2 L3.4,5.6 L6.6,5.6 L6.6,1.6 L9.4,1.6 L9.4,5.6 L12.6,5.6 Z M2.6,12 L13.4,12 L13.4,13.7 L2.6,13.7 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Trash">F1 M6.2,1.3 L9.8,1.3 L9.8,3.2 L6.2,3.2 Z M2.6,3.4 L13.4,3.4 L13.4,5.2 L2.6,5.2 Z M4,5.7 L12,5.7 L11,14.2 L5,14.2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Clipboard">M3.1,2.6 L12.9,2.6 L12.9,14.2 L3.1,14.2 Z M4.6,4.1 L11.4,4.1 L11.4,12.7 L4.6,12.7 Z M6,1 L10,1 L10,3.6 L6,3.6 Z M5.9,8.3 L7.4,9.8 L10.7,6.5 L12,7.8 L7.4,12.4 L4.6,9.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Person">F1 M8,1.8 A2.5,2.5 0 1 0 8,6.8 A2.5,2.5 0 1 0 8,1.8 Z M8,7.6 C4.6,7.6 2.2,9.8 2.2,13 L2.2,14.2 L13.8,14.2 L13.8,13 C13.8,9.8 11.4,7.6 8,7.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.SwitchAccount">F1 M2,3.1 L9.5,3.1 L9.5,1.4 L14,4.6 L9.5,7.8 L9.5,6.1 L2,6.1 Z M14,12.9 L6.5,12.9 L6.5,14.6 L2,11.4 L6.5,8.2 L6.5,9.9 L14,9.9 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Instance">M8,1.2 L14.4,4.8 L14.4,11.2 L8,14.8 L1.6,11.2 L1.6,4.8 Z M7.3,7.6 L8.7,7.6 L8.7,14.8 L7.3,14.8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Check">M2.6,8.4 L6.4,12.2 L14.6,3 L13,1.6 L6.4,9.4 L4.2,7.2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.News">M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z M8,2.7 A5.3,5.3 0 1 0 8,13.3 A5.3,5.3 0 1 0 8,2.7 Z M8,5 A1.1,1.1 0 1 0 8,7.2 A1.1,1.1 0 1 0 8,5 Z M7.15,8.2 L8.85,8.2 L8.85,11.6 L7.15,11.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Minimize">M2,7.15 L14,7.15 L14,8.85 L2,8.85 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Maximize">M2.6,2.6 L13.4,2.6 L13.4,13.4 L2.6,13.4 Z M4,4 L4,12 L12,12 L12,4 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Close">M2.6,4 L4,2.6 L8,6.6 L12,2.6 L13.4,4 L9.4,8 L13.4,12 L12,13.4 L8,9.4 L4,13.4 L2.6,12 L6.6,8 Z</StreamGeometry>

        <CornerRadius x:Key="R">10</CornerRadius>
        <CornerRadius x:Key="Radius.Window">22</CornerRadius>
        <CornerRadius x:Key="Radius.Dialog">22</CornerRadius>
        <CornerRadius x:Key="Radius.Card">18</CornerRadius>
        <CornerRadius x:Key="Radius.Container">13</CornerRadius>
        <CornerRadius x:Key="Radius.Control">10</CornerRadius>
        <CornerRadius x:Key="Radius.Small">8</CornerRadius>
        <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

        <sys:Double x:Key="Space.1">4</sys:Double>
        <sys:Double x:Key="Space.2">8</sys:Double>
        <sys:Double x:Key="Space.3">12</sys:Double>
        <sys:Double x:Key="Space.4">16</sys:Double>
        <sys:Double x:Key="Space.5">20</sys:Double>
        <sys:Double x:Key="Space.6">24</sys:Double>
        <sys:Double x:Key="Space.8">32</sys:Double>
        <sys:Double x:Key="Space.10">40</sys:Double>
        <sys:Double x:Key="Size.Hit.Min">40</sys:Double>
        <sys:Double x:Key="Size.Button.PrimaryHeight">44</sys:Double>
        <sys:Double x:Key="Size.Nav.Height">40</sys:Double>
        <sys:Double x:Key="Size.Nav.MinWidth">78</sys:Double>
        <sys:Double x:Key="Size.Nav.GroupWidth">430</sys:Double>
        <sys:Double x:Key="Size.TopBar.Height">68</sys:Double>
        <sys:Double x:Key="Size.Highlight.Height">16</sys:Double>
        <sys:Double x:Key="Size.Input.Height">40</sys:Double>
        <sys:Double x:Key="Size.List.Row">52</sys:Double>
        <sys:Double x:Key="Size.Icon.Sm">14</sys:Double>
        <sys:Double x:Key="Size.Icon.Md">18</sys:Double>
        <sys:Double x:Key="Size.Icon.Lg">24</sys:Double>
        <sys:Double x:Key="Size.Brand.Icon">28</sys:Double>
        <sys:Double x:Key="Size.Dialog.MinWidth">420</sys:Double>
        <sys:Double x:Key="Size.Dialog.MaxWidth">720</sys:Double>
        <sys:Double x:Key="Size.Task.DetailMaxHeight">120</sys:Double>
        <sys:Double x:Key="Size.Task.DrawerWidth">400</sys:Double>
        <sys:Double x:Key="Size.News.HeroHeight">200</sys:Double>
        <sys:Double x:Key="Size.Switch.Width">40</sys:Double>
        <sys:Double x:Key="Size.Switch.Height">22</sys:Double>
        <sys:Double x:Key="Size.Switch.Knob">16</sys:Double>
        <sys:Double x:Key="Size.ScrollBar">8</sys:Double>
        <sys:Double x:Key="Size.Progress.IndeterminateWidth">72</sys:Double>

        <sys:Double x:Key="Font.Display">34</sys:Double>
        <sys:Double x:Key="Font.H1">21</sys:Double>
        <sys:Double x:Key="Font.H2">17</sys:Double>
        <sys:Double x:Key="Font.H3">15</sys:Double>
        <sys:Double x:Key="Font.Body">14</sys:Double>
        <sys:Double x:Key="Font.BodySmall">13</sys:Double>
        <sys:Double x:Key="Font.Caption">12</sys:Double>
        <sys:Double x:Key="Font.Micro">11</sys:Double>
        <sys:Double x:Key="LineHeight.Body">22</sys:Double>
        <sys:Double x:Key="LineHeight.Caption">18</sys:Double>

        <Thickness x:Key="Margin.Page">20,18,20,12</Thickness>
        <Thickness x:Key="Margin.SectionBottom">0,0,0,24</Thickness>
        <Thickness x:Key="Margin.CardBottom">0,0,0,16</Thickness>
        <Thickness x:Key="Margin.ItemBottom">0,0,0,8</Thickness>
        <Thickness x:Key="Margin.ItemRight">0,0,8,0</Thickness>
        <Thickness x:Key="Margin.IconRight">0,0,8,0</Thickness>
        <Thickness x:Key="Margin.TextTop">0,4,0,0</Thickness>
        <Thickness x:Key="Margin.TextBottom">0,0,0,8</Thickness>
        <Thickness x:Key="Margin.HeaderBottom">0,0,0,16</Thickness>
        <Thickness x:Key="Margin.ActionsTop">0,8,0,0</Thickness>
        <Thickness x:Key="Margin.NavItem">2</Thickness>
        <Thickness x:Key="Margin.Brand">16,0,8,0</Thickness>
        <Thickness x:Key="Margin.WindowButtons">0,0,8,0</Thickness>
        <Thickness x:Key="Margin.Toast">0,0,0,24</Thickness>
        <Thickness x:Key="Margin.Empty">24,48,24,48</Thickness>
        <Thickness x:Key="Margin.Hero">16,12</Thickness>
        <Thickness x:Key="Padding.Card">16</Thickness>
        <Thickness x:Key="Padding.Container">12</Thickness>
        <Thickness x:Key="Padding.Control">12,7</Thickness>
        <Thickness x:Key="Padding.Input">12,6</Thickness>
        <Thickness x:Key="Padding.Nav">12,6</Thickness>
        <Thickness x:Key="Padding.NavShell">4</Thickness>
        <Thickness x:Key="Padding.Badge">6,1</Thickness>
        <Thickness x:Key="Padding.Toast">18,9</Thickness>
        <Thickness x:Key="Padding.TaskAction">8,4</Thickness>
        <Thickness x:Key="Border.Thin">1</Thickness>

        <!-- 卡片阴影：Avalonia 用 BoxShadow，比 WPF 的位图 Effect 便宜 -->
        <BoxShadows x:Key="Shadow.Card">0 6 32 0 #47000000</BoxShadows>
        <BoxShadows x:Key="Shadow.Dialog">0 12 64 0 #73000000</BoxShadows>
    </Styles.Resources>

    <!-- ================= 文字 ================= -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{StaticResource Font.H1}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{StaticResource Font.H2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="{StaticResource Margin.TextBottom}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="{StaticResource Font.H3}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}"/>
    </Style>

    <Style Selector="TextBlock.sub">
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}"/>
    </Style>

    <!-- 图标：PathIcon 自绘。几何统一画在 16×16 视口内，外层用 Viewbox 等比缩放，
         这样每个图标的视觉尺寸一致（PathIcon 默认按各自几何边界伸缩，会大小不一）。 -->
    <Style Selector="PathIcon.icon">
        <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- Fluent 主题给 PathIcon 设了默认 Foreground，优先级高于属性继承，
             会导致按钮里的图标固定为黑色。这里显式从父级按钮取色。
             独立使用的图标请在本地直接设 Foreground，本地值优先。 -->
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Stretch="Uniform">
                    <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}"
                          Width="16" Height="16" Stretch="None"/>
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ================= 卡片 ================= -->
    <Style Selector="Border.cardbox">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGradient}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Card}"/>
        <Setter Property="Margin" Value="{StaticResource Margin.CardBottom}"/>
    </Style>

    <Style Selector="Border.cardbox.elevated">
        <Setter Property="BoxShadow" Value="{StaticResource Shadow.Card}"/>
    </Style>

    <Style Selector="Border.taskrow">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Container}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Container}"/>
        <Setter Property="Margin" Value="{StaticResource Margin.ItemBottom}"/>
    </Style>

    <Style Selector="Border.navpill">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.NavShell}"/>
    </Style>

    <Style Selector="Border.dialogborder">
        <Setter Property="Background" Value="{DynamicResource DialogSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGradient}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}"/>
        <Setter Property="BoxShadow" Value="{StaticResource Shadow.Dialog}"/>
    </Style>

    <!-- ================= 按钮 ================= -->
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.BodySmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Control}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Hit.Min}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- 主按钮 -->
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Button.PrimaryHeight}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}"/>
    </Style>

    <!-- 危险操作 -->
    <Style Selector="Button.dangerbutton">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    </Style>

    <Style Selector="Button.dangerbutton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
    </Style>

    <Style Selector="Button.dangerbutton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Danger}"/>
    </Style>

    <!-- 无边框按钮 -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.TaskAction}"/>
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
    </Style>

    <!-- 顶栏图标按钮 -->
    <Style Selector="Button.titleicon">
        <Setter Property="Width" Value="{StaticResource Size.Hit.Min}"/>
        <Setter Property="Height" Value="{StaticResource Size.Hit.Min}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.titleicon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
    </Style>

    <!-- ================= 顶部导航 ================= -->
    <Style Selector="RadioButton.topnav">
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="{StaticResource Margin.NavItem}"/>
        <Setter Property="MinWidth" Value="{StaticResource Size.Nav.MinWidth}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Nav.Height}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Nav}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="b" Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.topnav:pointerover /template/ Border#b">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
    </Style>

    <Style Selector="RadioButton.topnav:checked /template/ Border#b">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="RadioButton.topnav:checked">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>

    <Style Selector="RadioButton.topnav:checked:pointerover /template/ Border#b">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>

    <Style Selector="RadioButton.topnav:checked:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentHover}"/>
    </Style>

    <!-- ================= 侧栏导航 ================= -->
    <Style Selector="RadioButton.sidenav">
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.BodySmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Hit.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Container}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="b" Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.sidenav:pointerover /template/ Border#b">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
    </Style>

    <Style Selector="RadioButton.sidenav:checked /template/ Border#b">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>

    <Style Selector="RadioButton.sidenav:checked">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ================= 胶囊筛选 ================= -->
    <Style Selector="RadioButton.pill">
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.BodySmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Hit.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Control}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="b" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.pill:pointerover /template/ Border#b">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
    </Style>

    <Style Selector="RadioButton.pill:checked /template/ Border#b">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="RadioButton.pill:checked">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>

    <!-- ================= 开关 ================= -->
    <Style Selector="CheckBox.switch">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.BodySmall}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Hit.Min}"/>
    </Style>

    <!-- ================= 输入 ================= -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Input}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Input.Height}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Input}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Input.Height}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Hit.Min}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}"/>
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
    </Style>

    <!-- ================= 列表 ================= -->
    <Style Selector="ListBox.cardlist">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox.cardlist ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="{StaticResource Margin.ItemBottom}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Container}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Container}"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ListBox.cardlist ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    </Style>

    <Style Selector="ListBox.cardlist ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- ================= 进度条 ================= -->
    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}"/>
    </Style>

    <!-- ================= 滚动条 ================= -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumb}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
    </Style>

    <!-- ================= 其他 ================= -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource DialogSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGradient}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Hit.Min}"/>
    </Style>

</Styles>
