<UserControl x:Class="MoonLauncher.UI.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <StreamGeometry x:Key="GearGeometry">M19.4,15 A1.6,1.6 0 0 0 19.72,16.77 L19.78,16.83 A2,2 0 1 1 16.95,19.66 L16.89,19.6 A1.6,1.6 0 0 0 15.12,19.28 A1.6,1.6 0 0 0 14,21.27 L14,21.38 A2,2 0 1 1 10,21.38 L10,21.27 A1.6,1.6 0 0 0 8.95,19.8 A1.6,1.6 0 0 0 7.18,20.12 L7.12,20.18 A2,2 0 1 1 4.29,17.35 L4.35,17.29 A1.6,1.6 0 0 0 4.6,15 A1.6,1.6 0 0 0 3.13,14 L3,14 A2,2 0 1 1 3,10 L3.11,10 A1.6,1.6 0 0 0 4.6,8.94 A1.6,1.6 0 0 0 4.32,7.17 L4.26,7.11 A2,2 0 1 1 7.09,4.28 L7.15,4.34 A1.6,1.6 0 0 0 8.88,4.6 A1.6,1.6 0 0 0 9.9,3.13 L9.9,3 A2,2 0 1 1 13.9,3 L13.9,3.11 A1.6,1.6 0 0 0 14.9,4.6 A1.6,1.6 0 0 0 16.67,4.28 L16.73,4.22 A2,2 0 1 1 19.56,7.05 L19.5,7.11 A1.6,1.6 0 0 0 19.18,8.88 L19.18,9 A1.6,1.6 0 0 0 20.65,10 L21,10 A2,2 0 1 1 21,14 L20.89,14 A1.6,1.6 0 0 0 19.4,15 Z M15,12 A3.2,3.2 0 1 0 8.6,12 A3.2,3.2 0 1 0 15,12 Z</StreamGeometry>
        <Style x:Key="VersionList" TargetType="ListBox" BasedOn="{StaticResource CardList}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Margin" Value="0,0,0,3"/>
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="MinHeight" Value="46"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0AFFFFFF"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            <Setter TargetName="b" Property="BorderBrush" Value="#5793A7FF"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GearButton" TargetType="Button" BasedOn="{StaticResource TitleIcon}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
        </Style>
        <Style x:Key="AccountMenuItem" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        </Style>
        <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="33"/>
            <Setter Property="MinHeight" Value="33"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#13FFFFFF"/>
            <Setter Property="BorderBrush" Value="#29FFFFFF"/>
            <Setter Property="Foreground" Value="#E8EDFA"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="DockButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#F00E1119"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.4" Color="#000000"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DockIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{DynamicResource Text3}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LaunchLayout" Margin="22,18,22,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LaunchRailColumn" Width="336"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="14" Padding="10" Height="60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="9" Background="#14171F" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="AvatarFallback" Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="19"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="Avatar" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PlayerName" Text="未登录" Foreground="{DynamicResource Text}" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="4" Height="4" Fill="#6D7891" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="AccountType" Text="离线登录" Foreground="{DynamicResource TextDisabled}"
                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="AccountMenuButton" Grid.Column="2" Style="{StaticResource TitleIcon}" Width="27" Height="27"
                            Click="Accounts_Click" ToolTip="账号选项" AutomationProperties.Name="账号选项">
                        <Path x:Name="AccountCaret" Width="9" Height="6" Data="M0.6,0.6 L4.4,6.4 L9.4,0.6 Z"
                              Fill="{DynamicResource Text3}" Stretch="Uniform" RenderTransformOrigin="0.5,0.45">
                            <Path.RenderTransform><RotateTransform x:Name="AccountCaretRotation"/></Path.RenderTransform>
                        </Path>
                    </Button>
                    <Popup x:Name="AccountMenu" PlacementTarget="{Binding ElementName=AccountMenuButton}" Placement="Bottom"
                           HorizontalOffset="-151" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" Closed="AccountMenu_Closed">
                        <Border Width="178" Background="#F7141720" BorderBrush="#17FFFFFF" BorderThickness="1" CornerRadius="12"
                                Padding="5" Margin="0,6,8,8" Effect="{StaticResource Shadow.Dialog}">
                            <StackPanel>
                                <Button Style="{StaticResource AccountMenuItem}" Click="SwitchAccounts_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" Margin="0,0,9,0"/>
                                        <TextBlock Text="切换其他账号"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AccountMenuItem}" Click="NewAccount_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,9,0"/>
                                        <TextBlock Text="新建账号"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Button x:Name="LaunchButton" Grid.Row="1" Style="{StaticResource PlayButton}" MinHeight="44" Height="44"
                    Margin="0,11,0,0" Click="Launch_Click" Padding="8,4">
                <TextBlock x:Name="LaunchText" Text="启动游戏" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource OnAccent}"/>
            </Button>

            <Grid Grid.Row="2" Margin="2,12,2,11" Height="27">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="版本列表" Foreground="{DynamicResource Text2}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Grid.Column="1" Background="#09FFFFFF" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="13.5" Padding="9,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource TextDisabled}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="VersionSearch" Grid.Column="1" Style="{StaticResource InlineSearch}" Tag="搜索版本……"
                                 FontSize="11.5" TextChanged="VersionSearch_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#04FFFFFF" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="14" Padding="6" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="InstanceEmpty" Text="没有找到匹配的版本" Style="{StaticResource Sub}" TextWrapping="Wrap"
                               TextAlignment="Center" VerticalAlignment="Center" Margin="8,22" Visibility="Collapsed"/>
                    <ListBox x:Name="InstanceList" Style="{StaticResource VersionList}"
                             SelectionChanged="InstanceList_SelectionChanged" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{Binding Badge}"
                                            BorderBrush="#16FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="12.5" FontWeight="Bold" Foreground="#F2F5FC"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Text}" FontWeight="Medium" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Id}"/>
                                        <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource TextDisabled}" FontSize="10.5"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Desc}"/>
                                    </StackPanel>
                                    <Button x:Name="gear" Grid.Column="2" Style="{StaticResource GearButton}" Content="&#xE713;"
                                            Tag="{Binding Instance}" Click="InstanceGear_Click" ToolTip="版本设置" VerticalAlignment="Center"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="gear" Property="Opacity" Value="0.72"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="gear" Property="Opacity" Value="0.72"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Button Grid.Row="4" Style="{StaticResource BaseButton}" MinHeight="36" Height="36" Margin="0,11,0,0"
                    Padding="8,4" Click="VersionSettings_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Width="13" Height="13" Data="{StaticResource GearGeometry}" Style="{StaticResource DockIcon}" Margin="0,0,7,0"/>
                    <TextBlock Text="版本设置" FontSize="12.5"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <Border x:Name="NewsCard" Style="{StaticResource CardBox}" Padding="0" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Margin="22,15,22,13">
                            <TextBlock Text="Minecraft 资讯" Foreground="{DynamicResource Text}" FontSize="13.5" FontWeight="SemiBold"/>
                            <Rectangle Width="172" MaxWidth="172" Height="1" Fill="{StaticResource NewsRule}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>

                        <Grid x:Name="NewsHero" Height="280" Visibility="Collapsed" Cursor="Hand" MouseDown="NewsHero_Click">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#101728" Offset="0"/>
                                    <GradientStop Color="#0B1120" Offset="0.46"/>
                                    <GradientStop Color="#080B13" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Border Background="{DynamicResource AccentSoft}" IsHitTestVisible="False">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="{StaticResource Size.Icon.Lg}"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="NewsHeroImage" Stretch="UniformToFill"/>
                            <Rectangle Fill="{DynamicResource HeroOverlay}" IsHitTestVisible="False"/>
                            <Grid x:Name="NewsFoot" VerticalAlignment="Bottom" Margin="24,22,52,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel x:Name="NewsLead" VerticalAlignment="Bottom" Margin="0,0,32,0">
                                    <TextBlock x:Name="NewsHeroTitle" FontSize="26" FontWeight="Bold" LineHeight="32"
                                               Foreground="#F2F5FC" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="68" Margin="0,0,0,13" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <Button Style="{StaticResource HeroButton}" HorizontalAlignment="Left" Click="NewsSource_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="打开 Minecraft 官网"/>
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="7,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="NewsHeroDesc" Grid.Column="1" Style="{StaticResource Sub}" Foreground="#A8CED0E8"
                                           FontSize="11.5" LineHeight="20" MaxHeight="102" VerticalAlignment="Bottom"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                        </Grid>

                        <StackPanel Margin="22,0,22,18">
                            <TextBlock x:Name="NewsLoading" Text="正在加载官方新闻…" Style="{StaticResource Sub}" Margin="0,14,0,0"/>
                            <StackPanel x:Name="NewsError" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock x:Name="NewsErrorText" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                <Button Content="重试" Style="{StaticResource Ghost}" MinHeight="36" HorizontalAlignment="Left"
                                        Margin="-8,8,0,-6" Click="NewsRetry_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 非默认内容：只在实际启动或游戏运行时出现。 -->
                <Border x:Name="LaunchProgressPanel" Style="{StaticResource CardBox}" Visibility="Collapsed" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LaunchStep" Text="正在启动…" Style="{StaticResource H2}" Margin="0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button Grid.Column="1" Content="取消启动" Style="{StaticResource Ghost}" MinHeight="36"
                                    Margin="12,-6,-6,-6" Click="CancelLaunch_Click"/>
                        </Grid>
                        <ProgressBar x:Name="LaunchBar" Maximum="1" Margin="0,12,0,4"/>
                    </StackPanel>
                </Border>
                <Border x:Name="RunningCard" Style="{StaticResource CardBox}" Visibility="Collapsed" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RunningTitle" Text="游戏运行中" Style="{StaticResource H2}" Margin="0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="打开目录" Style="{StaticResource Ghost}" MinHeight="36" Click="OpenGameDir_Click"/>
                                <Button Content="结束游戏" Style="{StaticResource DangerButton}" Padding="12,5" Margin="6,0,0,0" Click="KillGame_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="GameLog" Margin="0,12,0,0" Height="190" IsReadOnly="True" FontFamily="{StaticResource FontFamily.Mono}"
                                 FontSize="11.5" VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Card}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="5">
            <Button Style="{StaticResource DockButton}" Margin="0,0,0,8" Click="DockSettings_Click" ToolTip="设置" AutomationProperties.Name="设置">
                <Path Data="{StaticResource GearGeometry}" Style="{StaticResource DockIcon}"/>
            </Button>
            <Button x:Name="DockContrastButton" Style="{StaticResource DockButton}" Margin="0,0,0,8" Click="DockContrast_Click" ToolTip="切换黑白" AutomationProperties.Name="切换黑白">
                <Grid Width="16" Height="16">
                    <Ellipse Width="16" Height="16" Stroke="{DynamicResource Text3}" StrokeThickness="1.8"/>
                    <Ellipse Width="16" Height="16" Fill="{DynamicResource Text3}">
                        <Ellipse.Clip><RectangleGeometry Rect="8,0,8,16"/></Ellipse.Clip>
                    </Ellipse>
                </Grid>
            </Button>
            <Button Style="{StaticResource DockButton}" Margin="0,0,0,8" Click="DockTerminal_Click" ToolTip="终端" AutomationProperties.Name="终端">
                <Path Data="M5.6,3 L18.4,3 A2.6,2.6 0 0 1 21,5.6 L21,17.4 A2.6,2.6 0 0 1 18.4,20 L5.6,20 A2.6,2.6 0 0 1 3,17.4 L3,5.6 A2.6,2.6 0 0 1 5.6,3 Z M7.6,9.4 L10.3,12 L7.6,14.6 M12.8,15 L16.4,15" Style="{StaticResource DockIcon}"/>
            </Button>
            <Button Style="{StaticResource DockButton}" Click="DockHelp_Click" ToolTip="帮助" AutomationProperties.Name="帮助">
                <Path Data="M20.4,12 A8.4,8.4 0 1 0 3.6,12 A8.4,8.4 0 1 0 20.4,12 Z M9.7,9.4 A2.4,2.4 0 0 1 13,11.6 C12.4,11.87 12,12.5 12,13.16 L12,13.6 M12,16.9 L12.01,16.9" Style="{StaticResource DockIcon}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
