<UserControl x:Class="MoonLauncher.UI.Pages.MorePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.tooltitle">
            <Setter Property="FontSize" Value="{StaticResource Font.H3}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.toolaction">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Margin.Page}" MaxWidth="980">
            <Border Classes="cardbox">
                <StackPanel>
                    <TextBlock Text="维护工具" Classes="h2"/>
                    <TextBlock Text="排查崩溃、查看诊断日志并维护启动器缓存。" Classes="sub"
                               Margin="{StaticResource Margin.ItemBottom}"/>

                    <Grid Margin="{StaticResource Margin.ItemBottom}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="手动分析崩溃" Classes="tooltitle"/>
                            <TextBlock Text="选择日志或崩溃报告，结合当前版本与 Mod 列表分析。" Classes="sub"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="分析崩溃日志" Classes="toolaction" Click="Analyze_Click"/>
                    </Grid>

                    <Grid Margin="{StaticResource Margin.ItemBottom}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="启动器日志" Classes="tooltitle"/>
                            <TextBlock Text="查看最近 500 行日志，或打开日志目录获取完整文件。" Classes="sub"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="查看启动器日志" Classes="toolaction" Click="LauncherLog_Click"/>
                    </Grid>

                    <Grid Margin="{StaticResource Margin.ItemBottom}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="缓存与临时文件" Classes="tooltitle"/>
                            <TextBlock Text="清理临时文件、图标与皮肤缓存，不影响游戏文件。" Classes="sub"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="清理缓存与临时文件" Classes="toolaction" Click="Clean_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="下载源诊断" Classes="tooltitle"/>
                            <TextBlock Text="测试官方源、已配置镜像及社区资源站的连通性。" Classes="sub"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="测试下载源连通性" Classes="toolaction" Click="Ping_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="cardbox">
                <StackPanel>
                    <TextBlock Text="更新与关于" Classes="h2"/>
                    <Grid Margin="{StaticResource Margin.ItemBottom}" ColumnDefinitions="Auto,*">
                        <Image Source="avares://MoonLauncher/Assets/icon.png" Width="64" Height="64"
                               RenderOptions.BitmapInterpolationMode="None"
                               Margin="0,0,16,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Name="AboutTitle" Text="MoonLauncher" Classes="h1"/>
                            <TextBlock Name="AboutSub" Classes="sub" Margin="0,2,0,8"/>
                            <TextBlock Classes="body"
                                       Text="一个没有中心服务器的 Minecraft 启动器：下载走官方源和公益镜像，更新走签名清单，代码开源（GPL-3.0），任何人都可以编译、镜像、接手维护。我们不保证持续更新——但保证你不需要我们也能继续用、继续更新。"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="{StaticResource Margin.ActionsTop}">
                        <Button Content="项目主页" Margin="0,0,8,8" Click="Repo_Click"/>
                        <Button Content="检查更新" Classes="primary" Margin="0,0,8,8" Click="Update_Click"/>
                        <Button Content="打开数据目录" Margin="0,0,0,8" Click="DataDir_Click"/>
                    </WrapPanel>

                    <Border Classes="divider" Margin="0,12,0,16"/>
                    <TextBlock Text="常见问题" Classes="h2"/>
                    <TextBlock Classes="body">
                        <Run FontWeight="SemiBold" Text="下载很慢 / 失败？"/><LineBreak/>
                        <Run Text="设置 → 常用 → 下载 里切换“镜像优先 / 官方优先”，或者关掉连不上的镜像。所有文件都带校验，换源不会下到坏文件。"/><LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold" Text="微软登录提示要配置 Client ID？"/><LineBreak/>
                        <Run Text="去中心化启动器不共用一个会被封的 ID。去 设置 → 高级 → API 填你自己或你信任的发行版提供的 Client ID；也可以先用离线账号或外置登录。"/><LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold" Text="原作者不更新了怎么办？"/><LineBreak/>
                        <Run Text="游戏和 Mod 列表都是实时从上游获取的，启动器旧了也能装新版本。需要程序更新时，在 设置 → 高级 → 更新源与公钥 添加社区维护者的公钥和更新源即可。"/><LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold" Text="能导入 PCL / HMCL 的游戏目录吗？"/><LineBreak/>
                        <Run Text="能。版本选择 → 添加已有的游戏目录，选那个 .minecraft 文件夹，版本隔离的设置会自动识别。"/>
                    </TextBlock>

                    <Border Classes="divider" Margin="0,16,0,12"/>
                    <TextBlock Text="致谢" Classes="h2"/>
                    <TextBlock Classes="body" Text="BMCLAPI（bangbang93）· MCIM 镜像 · Modrinth · CurseForge · authlib-injector（yushijinhun）· Fabric · Quilt · Forge · NeoForge · Mojang。本启动器与 Mojang、Microsoft 无关；Minecraft 是 Mojang AB 的商标。灵感来自 PCL 等国内启动器前辈。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
