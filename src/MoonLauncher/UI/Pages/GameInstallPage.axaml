<UserControl x:Class="MoonLauncher.UI.Pages.GameInstallPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,16,22,16" MaxWidth="760" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Classes="ghost" Click="Back_Click" Margin="-8,0,6,0">
                    <TextBlock Text="←" Classes="icon"/>
                </Button>
                <TextBlock x:Name="Header" Text="安装" Classes="h1" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Classes="cardbox">
                <StackPanel>
                    <TextBlock Text="选择加载器" Classes="h2"/>
                    <TextBlock Classes="sub" Text="想装 Mod 选一个加载器；只想玩原版就选“原版”。Mod 下载页会按你选的加载器筛选。" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="LNone" GroupName="ld" Classes="pill" Content="原版" IsChecked="True" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LFabric" GroupName="ld" Classes="pill" Content="Fabric" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LForge" GroupName="ld" Classes="pill" Content="Forge" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LNeo" GroupName="ld" Classes="pill" Content="NeoForge" Checked="Loader_Checked"/>
                        <RadioButton x:Name="LQuilt" GroupName="ld" Classes="pill" Content="Quilt" Checked="Loader_Checked"/>
                    </WrapPanel>
                    <Grid x:Name="LoaderRow" Margin="0,8,0,0" IsVisible="False">
                        <TextBlock x:Name="LoaderLabel" Text="版本" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="LoaderStatus" Classes="sub" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="LoaderVersions" Width="300" SelectionChanged="LoaderVersions_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version}"/>
                                            <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="8,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="WithApi" Classes="switch" Margin="0,12,0,0" IsVisible="False" IsChecked="True"
                              Content="同时安装 Fabric API（绝大多数 Fabric Mod 都需要它）"/>
                    <Grid x:Name="OptiFineRow" Margin="0,12,0,0">
                        <CheckBox x:Name="WithOptiFine" Classes="switch" Content="同时安装 OptiFine（高清修复 / 光影）" Click="WithOptiFine_Click" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="OptiFineStatus" Classes="sub" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="OptiFineVersions" Width="300" IsVisible="False" SelectionChanged="LoaderVersions_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version}"/>
                                            <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource Text3}" FontSize="11" Margin="8,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="cardbox">
                <StackPanel>
                    <TextBlock Text="版本名" Classes="h2"/>
                    <TextBox x:Name="NameBox"/>
                    <TextBlock x:Name="NameHint" Classes="sub" Margin="0,6,0,0"
                               Text="会在 versions 文件夹里创建同名文件夹。装了加载器的版本默认开启版本隔离，Mod 和存档互不干扰。"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TargetText" Classes="sub" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="InstallButton" Content="开始安装" Classes="primary" Padding="26,9" FontSize="14" Click="Install_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
