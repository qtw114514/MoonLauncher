<UserControl x:Class="MoonLauncher.UI.Pages.ProjectPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MoonLauncher.UI">
    <Grid Margin="22,16,22,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Classes="ghost" Click="Back_Click" Margin="-8,0,6,0">
                <TextBlock Text="←" Classes="icon"/>
            </Button>
            <TextBlock Text="资源详情" Classes="h1" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
        <Border Classes="cardbox">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,16,0" ClipToBounds="True" VerticalAlignment="Top">
                    <Image x:Name="Icon" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PTitle" Classes="h1" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PMeta" Classes="sub" Margin="0,3,0,6"/>
                    <TextBlock x:Name="PDesc" Classes="body"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="打开网页" Click="Web_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Classes="cardbox" Margin="0,0,0,10" x:Name="DescCard" IsVisible="False">
            <StackPanel>
                <Grid>
                    <TextBlock Text="介绍" Classes="h2" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="McmodLink" Content="在 MC 百科打开" Classes="ghost" IsVisible="False" Click="Mcmod_Click"/>
                        <Button x:Name="DescToggle" Content="收起" Classes="ghost" Click="DescToggle_Click"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="DescContent">
                    <TextBlock x:Name="ZhStatus" Text="正在查找中文介绍…" Classes="sub" Margin="0,8,0,0" IsVisible="False"/>
                    <StackPanel x:Name="ZhPanel" IsVisible="False" Margin="0,8,0,0">
                        <TextBlock Text="中文简介（来自 MC 百科）" Classes="sub"/>
                        <TextBlock x:Name="ZhText" Classes="body" FontFamily="Microsoft YaHei, Microsoft YaHei UI, SimSun" FontSize="14" LineHeight="23" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="BodyText" Classes="body" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="FilesTitle" Text="选择要下载的文件" Classes="h2" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="OnlyMatch" Classes="switch" Content="只看适配当前筛选的" IsChecked="True" Click="OnlyMatch_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="TargetInfo" Classes="sub" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid>
            <ItemsControl x:Name="Files">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="cardbox" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding ReleaseTypeText}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="sub" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding LoadersText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Published, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="下载" Classes="primary" Padding="16,6" VerticalAlignment="Center" Click="Download_Click"/>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,30">
                <TextBlock x:Name="StatusText" Text="加载文件列表…" Classes="body" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <ProgressBar x:Name="StatusBar" IsIndeterminate="True" Width="200" Margin="0,10,0,0"/>
                <Button x:Name="RetryFiles" Content="重试" Margin="0,10,0,0" Padding="18,5" IsVisible="False" Click="RetryFiles_Click"/>
            </StackPanel>
        </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
