<UserControl x:Class="MoonLauncher.UI.Pages.GameListView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="22,18,22,14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="安装 Minecraft" Classes="h1"/>
                <TextBlock Text="选择版本与类型，安装前可配置加载器和目标位置。" Classes="sub" Margin="0,2,12,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Name="Search" Tag="搜索版本号" Width="200" TextChanged="Filter_Changed"/>
                <Button Content="刷新" Margin="8,0,0,0" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Classes="cardbox" Padding="12,6" Margin="0,0,0,10">
            <WrapPanel>
                <RadioButton Name="FRelease" GroupName="vt" Classes="pill" Content="正式版"
                             IsChecked="True" Checked="Filter_Changed"/>
                <RadioButton Name="FSnapshot" GroupName="vt" Classes="pill" Content="快照版" Checked="Filter_Changed"/>
                <RadioButton Name="FOld" GroupName="vt" Classes="pill" Content="远古版" Checked="Filter_Changed"/>
                <RadioButton Name="FFools" GroupName="vt" Classes="pill" Content="愚人节版" Checked="Filter_Changed"/>
                <RadioButton Name="FAll" GroupName="vt" Classes="pill" Content="全部" Checked="Filter_Changed"/>
            </WrapPanel>
        </Border>

        <Grid>
            <ListBox Name="List" Classes="cardlist" DoubleTapped="List_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="52" ColumnDefinitions="Auto,*,Auto">
                            <Border Width="40" Height="40" CornerRadius="{StaticResource Radius.Small}"
                                    Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                <TextBlock Text="MC" Foreground="{DynamicResource Accent}" FontWeight="Bold"
                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Id}" Classes="h3"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}"/>
                                <TextBlock Classes="sub">
                                    <Run Text="{Binding TypeText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding DateText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="安装" Classes="primary" Padding="16,6"
                                    VerticalAlignment="Center" Click="Install_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Name="Loading" Classes="cardbox" Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Name="LoadingText" Text="正在从官方获取版本列表…" Classes="body"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <ProgressBar Name="LoadingBar" IsIndeterminate="True" Width="220"
                                 Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <Button Name="RetryVersions" Content="重试" Margin="0,10,0,0" Padding="18,5"
                            HorizontalAlignment="Center" IsVisible="False" Click="Refresh_Click"/>
                </StackPanel>
            </Border>

            <Border Name="EmptyState" Classes="cardbox" Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <StackPanel>
                    <TextBlock Text="没有匹配的 Minecraft 版本" Classes="h2"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="当前关键词或版本类型没有结果，请修改搜索词或切换版本类型。" Classes="body"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
