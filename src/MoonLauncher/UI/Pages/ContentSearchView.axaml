<UserControl x:Class="MoonLauncher.UI.Pages.ContentSearchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MoonLauncher.UI">
    <DockPanel Margin="22,18,22,10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="Header" Text="Mod" Classes="h1" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="SrcAll" GroupName="src" Classes="pill" Content="全部" Margin="0,0,6,0" IsVisible="False" Checked="Source_Checked"/>
                <RadioButton x:Name="SrcModrinth" GroupName="src" Classes="pill" Content="Modrinth" Margin="0,0,6,0" Checked="Source_Checked"/>
                <RadioButton x:Name="SrcCurse" GroupName="src" Classes="pill" Content="CurseForge" Margin="0" Checked="Source_Checked"/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Query" Tag="搜索（支持常见中文名，如：钠、机械动力、JEI）" KeyDown="Query_KeyDown"/>
            <Button Grid.Column="1" Content="搜索" Classes="primary" Margin="8,0,0,0" Click="Search_Click"/>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="版本" Classes="sub" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="GameVersion" Width="120" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel x:Name="LoaderPanel" Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="加载器" Classes="sub" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Loader" Width="110" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部" Tag=""/>
                    <ComboBoxItem Content="Fabric" Tag="fabric"/>
                    <ComboBoxItem Content="Forge" Tag="forge"/>
                    <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                    <ComboBoxItem Content="Quilt" Tag="quilt"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="排序" Classes="sub" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Sort" Width="110" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="相关度" Tag="relevance"/>
                    <ComboBoxItem Content="下载量" Tag="downloads"/>
                    <ComboBoxItem Content="最近更新" Tag="updated"/>
                    <ComboBoxItem Content="最新发布" Tag="newest"/>
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="TargetPanel" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="安装到" Classes="sub" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Target" Width="200" SelectionChanged="Target_Changed"/>
            </StackPanel>
        </WrapPanel>

        <Grid>
            <ListBox x:Name="Results" Classes="cardlist" PointerReleased="Results_MouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Top">
                                <Image ui:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Author}" Classes="sub" Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Classes="sub" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,2,0,3"/>
                                <TextBlock Classes="sub">
                                    <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                    <Run Text=" · 下载 "/>
                                    <Run Text="{Binding DownloadsText, Mode=OneWay}"/>
                                    <Run Text=" · 更新于 "/>
                                    <Run Text="{Binding Updated, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                                </TextBlock>
                                <StackPanel IsVisible="{Binding IntroExpanded}" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding IntroStatus}" Classes="sub"/>
                                    <TextBlock Text="{Binding IntroText}" FontFamily="Microsoft YaHei, Microsoft YaHei UI, SimSun" FontSize="14" LineHeight="23" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <Button Content="在 MC 百科打开" Classes="ghost" HorizontalAlignment="Left" Margin="-8,3,0,0" IsVisible="{Binding HasMcmodUrl}" Click="McmodCard_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding IntroButtonText}" Classes="ghost" VerticalAlignment="Top" Margin="8,0,0,0" IsVisible="False" Loaded="IntroButton_Loaded" Click="Intro_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <TextBlock x:Name="StatusText" Classes="body" HorizontalAlignment="Center" TextAlignment="Center"/>
                <ProgressBar x:Name="StatusBar" IsIndeterminate="True" Width="200" Margin="0,10,0,0"/>
                <Button x:Name="RetrySearch" Content="重试" Margin="0,10,0,0" Padding="18,5" IsVisible="False" Click="RetrySearch_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
