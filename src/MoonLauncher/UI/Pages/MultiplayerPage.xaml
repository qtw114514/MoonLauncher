<UserControl x:Class="MoonLauncher.UI.Pages.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,12" MaxWidth="980">
            <TextBlock Text="联机" Style="{StaticResource H1}"/>
            <TextBlock Text="连接已有的业务服务器，或通过 Terracotta 官方进程进行点对点联机。" Style="{StaticResource Sub}" Margin="0,3,0,12"/>

            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="启动选项" Style="{StaticResource H2}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="账户" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AccountBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="AccountBox_SelectionChanged"/>
                        <Button Grid.Column="2" Content="管理" Margin="8,0,0,0" Click="ManageAccounts_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="实例" VerticalAlignment="Center"/>
                        <ComboBox x:Name="InstanceBox" Grid.Column="1" DisplayMemberPath="Id" SelectionChanged="InstanceBox_SelectionChanged"/>
                        <Button Grid.Column="2" Content="刷新" Margin="8,0,0,0" Click="RefreshInstances_Click"/>
                    </Grid>
                    <TextBlock Text="两个标签共用这里的账户和实例；陶瓦房间使用当前账户的玩家名。" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,0,0,8">
                <RadioButton x:Name="ServerTab" GroupName="multiplayerTab" Style="{StaticResource Pill}" Content="服务器" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="P2PTab" GroupName="multiplayerTab" Style="{StaticResource Pill}" Content="房间 P2P" Checked="Tab_Checked"/>
            </WrapPanel>

            <StackPanel x:Name="ServerPanel">
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="我的服务器" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="新增" Style="{StaticResource Primary}" Padding="12,5" Click="AddServer_Click"/>
                                <Button Content="修改" Padding="12,5" Margin="6,0,0,0" Click="EditServer_Click"/>
                                <Button Content="删除" Style="{StaticResource DangerButton}" Padding="12,5" Margin="6,0,0,0" Click="DeleteServer_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="ServerList" Style="{StaticResource CardList}" Height="190" SelectionChanged="ServerList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ServerEmpty" Text="还没有保存的服务器，点击“新增”添加名称和地址。" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock Text="一键进服" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="ServerLaunchDetail" Text="请先选择一个服务器" Style="{StaticResource Body}"/>
                        <Button x:Name="ServerLaunchButton" Content="启动游戏并尝试进入服务器" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="LaunchServer_Click"/>
                        <TextBlock Text="服务器地址仅作为本次启动的内存覆盖，不写入实例配置。启动成功不等于已经成功进入服务器，请以游戏内结果为准。" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="P2PPanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardBox}" Background="{DynamicResource AccentSoft}">
                    <StackPanel>
                        <TextBlock Text="Terracotta | 陶瓦联机 · Burning_TNT / 基于 EasyTier" Style="{StaticResource H2}" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="本页只调用 Terracotta 官方本地 HTTP API，不实现或模拟 P2P。官方程序采用 AGPLv3 or later 及打包 / IPC 例外。" Style="{StaticResource Body}"/>
                        <Button Content="打开 Terracotta 项目与许可说明" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,-4" Click="TerracottaProject_Click"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBox}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="创建房间" Style="{StaticResource H2}"/>
                            <TextBlock Text="房主需先在 Minecraft 中进入单人存档，并“对局域网开放”，然后再创建房间。房间码只显示官方返回值。" Style="{StaticResource Body}"/>
                            <Button x:Name="HostButton" Content="我已开放局域网，创建房间" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Host_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBox}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="加入房间" Style="{StaticResource H2}"/>
                            <TextBox x:Name="JoinRoomBox" Tag="U/XXXX-XXXX-XXXX-XXXX" FontFamily="Consolas, Microsoft YaHei UI"/>
                            <Button x:Name="JoinButton" Content="使用邀请码加入" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Join_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="P2PStateTitle" Text="尚未连接" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="P2PStateDetail" Style="{StaticResource Body}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="查看日志" Style="{StaticResource Ghost}" Click="Log_Click"/>
                                <Button x:Name="ResetButton" Content="重置 / 关闭房间" Style="{StaticResource DangerButton}" Margin="6,0,0,0" Click="Reset_Click"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="P2PBusyBar" IsIndeterminate="True" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <Grid x:Name="P2PBusyPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="P2PBusyText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,90,0"/>
                            <Button Content="取消操作" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="CancelOperation_Click"/>
                        </Grid>

                        <StackPanel x:Name="UnavailablePanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <WrapPanel>
                                <Button x:Name="InstallRetryButton" Content="安装 / 重试陶瓦服务" Style="{StaticResource Primary}" Margin="0,0,8,6" Click="InstallRetry_Click"/>
                                <Button Content="获取官方日志" Margin="0,0,8,6" Click="Log_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <Grid x:Name="InvitationPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="官方邀请码" Style="{StaticResource Sub}"/>
                                <TextBlock x:Name="InvitationCode" FontFamily="Consolas, Microsoft YaHei UI" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="CopyInvitationButton" Grid.Column="1" Content="复制邀请码" Margin="10,0,0,0" Click="CopyInvitation_Click"/>
                        </Grid>

                        <Border x:Name="GuestLaunchPanel" Background="{DynamicResource OkSoft}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="官方 guest-ok 已就绪" Foreground="{DynamicResource Ok}" FontWeight="SemiBold"/>
                                <TextBlock Text="进入地址（仅来自官方 url）" Style="{StaticResource Sub}" Margin="0,4,0,2"/>
                                <TextBlock x:Name="GuestServerUrl" FontFamily="Consolas, Microsoft YaHei UI" TextWrapping="Wrap"/>
                                <Button x:Name="GuestLaunchButton" Content="使用此地址一键进服" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="LaunchGuest_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="成员（仅显示官方就绪状态返回的列表）" Style="{StaticResource Sub}" Margin="0,14,0,6"/>
                        <ListBox x:Name="MemberList" Style="{StaticResource CardList}" Height="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MachineId}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Vendor}" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="MemberHint" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,10" Text="尚无官方成员列表"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
