<UserControl x:Class="MoonLauncher.UI.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:MoonLauncher.UI.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <pages:TaskRetryVisibilityConverter x:Key="RetryVis"/>
        <Style x:Key="FailedAction" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Margin.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="0"/>
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource Margin.HeaderBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="下载任务" Style="{StaticResource H1}"/>
                <TextBlock Text="查看活动与历史任务，恢复下载或排查失败原因。" Style="{StaticResource Sub}" Margin="{StaticResource Margin.TextTop}"/>
            </StackPanel>
            <Button x:Name="ClearFinishedButton" Grid.Column="1" Content="清除已结束" Style="{StaticResource BaseButton}"
                    VerticalAlignment="Center" Click="ClearTasks_Click"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="{StaticResource Margin.HeaderBottom}">
            <RadioButton x:Name="ActiveFilter" GroupName="taskFilter" Style="{StaticResource Pill}" IsChecked="True" Checked="Filter_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="活动" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock x:Name="ActiveCountText" Style="{StaticResource Sub}" Margin="{StaticResource Margin.ItemLeft}" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="HistoryFilter" GroupName="taskFilter" Style="{StaticResource Pill}" Checked="Filter_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="历史" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock x:Name="HistoryCountText" Style="{StaticResource Sub}" Margin="{StaticResource Margin.ItemLeft}" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
            </RadioButton>
        </WrapPanel>

        <ListBox x:Name="TaskList" Grid.Row="2" Style="{StaticResource CardList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Margin="{StaticResource Margin.ItemRight}" ToolTip="{Binding Title}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource Sub}"/>
                        </Grid>
                        <ProgressBar Margin="{StaticResource Margin.ActionsTop}" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" MaxHeight="{StaticResource Size.Task.DetailMaxHeight}"
                                   Margin="{StaticResource Margin.TextTop}"/>
                        <WrapPanel Margin="{StaticResource Margin.TextTop}">
                            <TextBlock Text="{Binding ProgressText, Mode=OneWay}" Style="{StaticResource Sub}" Margin="{StaticResource Margin.ItemRight}"/>
                            <TextBlock Text="{Binding SpeedText, Mode=OneWay}" Style="{StaticResource Sub}" Margin="{StaticResource Margin.ItemRight}"/>
                            <TextBlock Text="{Binding Started, StringFormat=开始：{0:MM-dd HH:mm}}" Style="{StaticResource Sub}"/>
                        </WrapPanel>
                        <WrapPanel Margin="{StaticResource Margin.ActionsTop}">
                            <Button Content="暂停" Style="{StaticResource Ghost}" Padding="{StaticResource Padding.TaskAction}" Click="PauseTask_Click"
                                    Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}"/>
                            <Button Content="继续" Style="{StaticResource Ghost}" Padding="{StaticResource Padding.TaskAction}" Click="ResumeTask_Click"
                                    Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"/>
                            <Button Content="取消" Style="{StaticResource Ghost}" Padding="{StaticResource Padding.TaskAction}" Click="CancelTask_Click"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"/>
                            <Button Content="重试" Style="{StaticResource Ghost}" Padding="{StaticResource Padding.TaskAction}" Click="RetryTask_Click">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource RetryVis}">
                                        <Binding Path="CanRetry"/>
                                        <Binding Path="Title"/>
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>
                            <Button Content="失败详情" Style="{StaticResource FailedAction}" Padding="{StaticResource Padding.TaskAction}" Click="TaskDetails_Click"/>
                            <Button Content="复制诊断" Style="{StaticResource FailedAction}" Padding="{StaticResource Padding.TaskAction}" Click="CopyTask_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="EmptyState" Grid.Row="2" Style="{StaticResource CardBox}" VerticalAlignment="Center" Margin="{StaticResource Margin.Empty}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="{StaticResource Size.Icon.Lg}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="暂时没有任务" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="{StaticResource Margin.ActionsTop}"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Body}" TextAlignment="Center"/>
                <Button Content="浏览资源" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="{StaticResource Margin.ActionsTop}" Click="BrowseResources_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
