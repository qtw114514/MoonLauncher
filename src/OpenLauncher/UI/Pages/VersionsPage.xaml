<UserControl x:Class="OpenLauncher.UI.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource Margin.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="0"/>
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource Margin.HeaderBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Ghost}" Click="Back_Click" Margin="-8,0,8,0" VerticalAlignment="Top"
                    ToolTip="返回启动页" AutomationProperties.Name="返回启动页">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}"/>
            </Button>
            <StackPanel Grid.Column="1">
                <TextBlock Text="版本选择" Style="{StaticResource H1}"/>
                <TextBlock Text="启动域 · 选择游戏目录与要启动的实例" Style="{StaticResource Sub}" Margin="{StaticResource Margin.TextTop}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- 主区：游戏目录库。所有目录操作均有显式按钮，右键菜单只是捷径。 -->
            <Border Style="{StaticResource CardBox}" Margin="0" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="游戏目录" Style="{StaticResource H2}"/>
                        <TextBlock Text="单击目录即可切换" Style="{StaticResource Sub}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="FolderPath" Style="{StaticResource Sub}" MaxHeight="54" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="OpenFolderBtn" Content="打开" Style="{StaticResource Ghost}" Padding="8,4" Margin="0,0,4,4" Click="OpenFolder_Click"/>
                            <Button x:Name="RenameFolderBtn" Content="重命名" Style="{StaticResource Ghost}" Padding="8,4" Margin="0,0,4,4" Click="RenameFolder_Click"/>
                            <Button x:Name="RemoveFolderBtn" Content="移除" Style="{StaticResource Ghost}" Padding="8,4" Margin="0,0,0,4" Click="RemoveFolder_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="添加目录" Click="AddFolder_Click" Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="新建目录" Style="{StaticResource Ghost}" Click="NewFolder_Click" Padding="8,4"/>
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="Folders" Style="{StaticResource CardList}" SelectionChanged="Folders_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开文件夹" Click="OpenFolder_Click"/>
                                <MenuItem Header="重命名" Click="RenameFolder_Click"/>
                                <MenuItem Header="从列表移除（不删除文件）" Click="RemoveFolder_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 从区：当前目录的版本与操作。 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="0"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBox}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="CurrentFolderName" Text="当前目录" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="CurrentFolderPath" Style="{StaticResource Sub}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="Search" Tag="搜索版本名称或描述" TextChanged="Search_TextChanged"/>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button x:Name="RefreshBtn" Content="刷新版本" Click="Refresh_Click" Margin="0,0,8,0"/>
                        <Button Content="导入整合包" Click="ImportPack_Click" Style="{StaticResource Primary}"/>
                    </WrapPanel>
                </Grid>

                <TextBlock x:Name="VersionStats" Grid.Row="2" Style="{StaticResource Sub}" Margin="2,0,0,8"/>

                <Grid Grid.Row="3">
                    <Border x:Name="Empty" Style="{StaticResource CardBox}" VerticalAlignment="Center" Margin="{StaticResource Margin.Empty}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="EmptyTitle" Text="这个目录里还没有版本" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource Body}" TextAlignment="Center"/>
                            <Button x:Name="DownloadBtn" Content="去下载一个" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="{StaticResource Margin.ActionsTop}" Click="GoDownload_Click"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="Versions" Style="{StaticResource CardList}" MouseDoubleClick="Versions_DoubleClick" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="8" Background="{Binding Badge}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Id}"/>
                                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Desc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Ghost}" Content="选择" Padding="8,4" ToolTip="设为启动页当前版本" Click="SelectItem_Click"/>
                                        <Button Style="{StaticResource Ghost}" ToolTip="启动" Click="LaunchItem_Click">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/>
                                        </Button>
                                        <Button Style="{StaticResource Ghost}" ToolTip="版本设置" Click="SettingsItem_Click">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/>
                                        </Button>
                                        <Button Style="{StaticResource Ghost}" ToolTip="打开文件夹" Click="FolderItem_Click">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
