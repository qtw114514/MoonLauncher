<UserControl x:Class="OpenLauncher.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Glass}">
            <Setter Property="Width" Value="260"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NestedItem" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Container}"/>
            <Setter Property="Padding" Value="{StaticResource Padding.Container}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,18,12,12">
                <Button Content="←" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-8,0,0,8" Click="Back_Click" ToolTip="返回更多" AutomationProperties.Name="返回更多"/>
                <TextBlock Text="设置" Style="{StaticResource H2}" Margin="12,0,0,2"/>
                <TextBlock Text="更改自动保存" Style="{StaticResource Sub}" Margin="12,0,0,12"/>
                <RadioButton x:Name="CommonMode" GroupName="settingsMode" Style="{StaticResource SideNav}" Tag="&#xE80F;" Content="常用" IsChecked="True" Checked="Mode_Checked"/>
                <RadioButton x:Name="AdvancedMode" GroupName="settingsMode" Style="{StaticResource SideNav}" Tag="&#xE713;" Content="高级" Checked="Mode_Checked"/>
                <Border Height="1" Background="{DynamicResource Line}" Margin="8,10,8,12"/>

                <StackPanel x:Name="CommonNav">
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE768;" Content="启动" IsChecked="True" Checked="Jump_Checked" CommandParameter="launch"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE896;" Content="下载" Checked="Jump_Checked" CommandParameter="download"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE77B;" Content="账户" Checked="Jump_Checked" CommandParameter="account"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE790;" Content="外观" Checked="Jump_Checked" CommandParameter="ui"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE895;" Content="更新检查" Checked="Jump_Checked" CommandParameter="update"/>
                </StackPanel>
                <StackPanel x:Name="AdvancedNav" Visibility="Collapsed">
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE943;" Content="Java" Checked="Jump_Checked" CommandParameter="java"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE768;" Content="JVM / 游戏参数" Checked="Jump_Checked" CommandParameter="args"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE896;" Content="自定义镜像" Checked="Jump_Checked" CommandParameter="mirrors"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE77B;" Content="API" Checked="Jump_Checked" CommandParameter="api"/>
                    <RadioButton GroupName="st" Style="{StaticResource SideNav}" Tag="&#xE895;" Content="更新源与公钥" Checked="Jump_Checked" CommandParameter="updateAdvanced"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Margin="{StaticResource Margin.Page}" MaxWidth="980">
                <StackPanel x:Name="CommonBody">
                    <!-- 基础启动 -->
                    <Border x:Name="SecLaunch" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="基础启动" Style="{StaticResource H2}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="版本隔离（默认）" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="Isolation" Grid.Column="1" Style="{StaticResource RowCombo}" SelectionChanged="Any_Changed">
                                    <ComboBoxItem Content="仅隔离装了 Mod 的版本（推荐）" Tag="modded"/>
                                    <ComboBoxItem Content="所有版本都隔离" Tag="all"/>
                                    <ComboBoxItem Content="都不隔离（共用 .minecraft）" Tag="none"/>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启动游戏后" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="AfterLaunch" Grid.Column="1" Style="{StaticResource RowCombo}" SelectionChanged="Any_Changed">
                                    <ComboBoxItem Content="最小化启动器" Tag="minimize"/>
                                    <ComboBoxItem Content="隐藏启动器（游戏退出后恢复）" Tag="hide"/>
                                    <ComboBoxItem Content="保持不变" Tag="keep"/>
                                    <ComboBoxItem Content="关闭启动器" Tag="close"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="MemAuto" Style="{StaticResource Switch}" Click="Any_Changed">
                                <TextBlock Text="自动分配游戏内存（按空闲内存和 Mod 数量估算）" TextWrapping="Wrap"/>
                            </CheckBox>
                            <Grid x:Name="MemRow" Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="MemSlider" Minimum="1024" Maximum="16384" TickFrequency="256" IsSnapToTickEnabled="True"
                                        Margin="0,0,16,0" ValueChanged="MemSlider_ValueChanged"/>
                                <TextBlock x:Name="MemText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="游戏窗口大小" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox x:Name="WinW" Width="70" LostFocus="Any_Changed"/>
                                    <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="WinH" Width="70" LostFocus="Any_Changed"/>
                                    <CheckBox x:Name="Fullscreen" Style="{StaticResource Switch}" Content="全屏" Margin="14,0,0,0" Click="Any_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="游戏窗口标题（留空不修改，可用 {version}）" Style="{StaticResource Sub}"/>
                            <TextBox x:Name="WinTitle" Margin="0,4,0,0" LostFocus="Any_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 下载 -->
                    <Border x:Name="SecDownload" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="下载" Style="{StaticResource H2}"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="游戏文件下载源" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="GameSource" Grid.Column="1" Style="{StaticResource RowCombo}" SelectionChanged="Any_Changed">
                                    <ComboBoxItem Content="镜像优先，失败自动换官方" Tag="0"/>
                                    <ComboBoxItem Content="官方优先，失败自动换镜像" Tag="1"/>
                                    <ComboBoxItem Content="只用官方源" Tag="2"/>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mod / 整合包下载源" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ModSource" Grid.Column="1" Style="{StaticResource RowCombo}" SelectionChanged="Any_Changed">
                                    <ComboBoxItem Content="镜像优先，失败自动换官方" Tag="0"/>
                                    <ComboBoxItem Content="官方优先，失败自动换镜像" Tag="1"/>
                                    <ComboBoxItem Content="只用官方源" Tag="2"/>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="同时下载数" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="Threads" Width="200" Minimum="1" Maximum="128" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Threads_ValueChanged"/>
                                    <TextBlock x:Name="ThreadsText" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="限速（KB/s，0 为不限）" Style="{StaticResource RowLabel}"/>
                                <TextBox x:Name="SpeedLimit" Grid.Column="1" Width="100" HorizontalAlignment="Right" LostFocus="Any_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 账户 -->
                    <Border x:Name="SecAccount" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="账户管理" Style="{StaticResource H2}"/>
                            <TextBlock Text="添加、切换或移除微软正版、离线及外置登录账户。" Style="{StaticResource Sub}" Margin="0,0,0,10"/>
                            <Button Content="管理账户" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="ManageAccounts_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 外观 -->
                    <Border x:Name="SecUi" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource H2}"/>
                            <TextBlock Text="主题色" Style="{StaticResource Sub}" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="ThemePresets"/>
                            <Grid Style="{StaticResource SettingRow}" Margin="0,6,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自定义颜色（#RRGGBB）" Style="{StaticResource RowLabel}"/>
                                <TextBox x:Name="ThemeHex" Grid.Column="1" Width="120" HorizontalAlignment="Right" LostFocus="ThemeHex_LostFocus"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="背景图片" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="选择图片" Click="PickBg_Click" Margin="0,0,6,0"/>
                                    <Button Content="清除" Style="{StaticResource Ghost}" Click="ClearBg_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="自定义主页（启动页顶部显示的内嵌网页）" Style="{StaticResource Sub}" Margin="0,8,0,4"/>
                            <TextBox x:Name="HomeUrl" Tag="填网址或本地 .html 文件路径，留空关闭" LostFocus="HomeUrl_LostFocus"/>
                            <CheckBox x:Name="GlassFx" Margin="0,10,0,0" Click="Glass_Click">
                                <TextBlock Text="液态玻璃（仿 macOS / iOS 的毛玻璃质感，即时生效）" TextWrapping="Wrap"/>
                            </CheckBox>
                            <StackPanel x:Name="GlassDebug" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="液态玻璃调试（拖动即时生效）" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="卡片透明度" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="GlassCardVal" Grid.Column="1" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="GlassCard" Minimum="0" Maximum="100" ValueChanged="GlassParam_ValueChanged"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="窗口背景透明度" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="GlassBgVal" Grid.Column="1" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="GlassBg" Minimum="0" Maximum="100" ValueChanged="GlassParam_ValueChanged"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="描边亮度" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="GlassEdgeVal" Grid.Column="1" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="GlassEdge" Minimum="0" Maximum="100" ValueChanged="GlassParam_ValueChanged"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景图浓度" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="GlassImgVal" Grid.Column="1" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="GlassImg" Minimum="0" Maximum="100" ValueChanged="GlassParam_ValueChanged"/>
                                <CheckBox x:Name="GlassAcrylic" Content="亚克力模糊（关闭则普通模糊）" Margin="0,8,0,0" Click="GlassParam_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 更新检查 -->
                    <Border x:Name="SecUpdate" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="更新检查" Style="{StaticResource H2}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button x:Name="CheckUpdateBtn" Grid.Column="1" Content="检查更新" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="CheckUpdate_Click"/>
                            </Grid>
                            <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" Content="启动时自动检查更新" Click="Any_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AdvancedBody" Visibility="Collapsed">
                    <!-- Java -->
                    <Border x:Name="SecJava" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="Java" Style="{StaticResource H2}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="恢复自动" Style="{StaticResource Ghost}" Margin="0,0,6,6" Click="ResetJava_Click"/>
                                <Button Content="重新扫描" Margin="0,0,6,6" Click="ScanJava_Click"/>
                                <Button Content="手动添加" Margin="0,0,6,6" Click="AddJava_Click"/>
                                <Button Content="下载 Java" Style="{StaticResource Primary}" Margin="0,0,0,6" Click="DownloadJava_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Sub}" Text="启动时会按版本需要自动挑选 Java（1.16 及以前用 8，1.17~1.20.4 用 17，1.20.5 起用 21，26.x 用 25），没有就自动从 Mojang 官方下载。" Margin="0,0,0,8"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="全局 Java" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="JavaGlobal" Grid.Column="1" Width="380" HorizontalAlignment="Right" SelectionChanged="Any_Changed"/>
                            </Grid>
                            <ItemsControl x:Name="JavaList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NestedItem}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource Sub}">
                                                    <Run Text="{Binding Source, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding JavawPath, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- JVM / 游戏参数 -->
                    <Border x:Name="SecLaunchArgs" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="JVM / 游戏参数" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="恢复默认值" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="ResetArgs_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Sub}" Text="仅供高级用户追加启动参数，默认均为空。启动器已自动处理内存和必要参数；不熟悉时请留空，错误参数可能导致游戏无法启动。" Margin="0,0,0,10"/>
                            <TextBlock Text="额外 JVM 参数" Style="{StaticResource Sub}"/>
                            <TextBox x:Name="JvmArgs" Margin="0,4,0,10" Tag="例如 -XX:+UseZGC（一般不用填）" LostFocus="Any_Changed"/>
                            <TextBlock Text="额外游戏参数" Style="{StaticResource Sub}"/>
                            <TextBox x:Name="GameArgs" Margin="0,4,0,0" LostFocus="Any_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 自定义镜像 -->
                    <Border x:Name="SecMirrors" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自定义镜像" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="添加自定义镜像" HorizontalAlignment="Right" Click="AddMirror_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Sub}" Text="每个官方地址都可以映射到多个镜像，下载时按顺序尝试、自动避开失败的。关掉某个镜像 = 不再使用它。" Margin="0,4,0,8"/>
                            <ItemsControl x:Name="MirrorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NestedItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" HorizontalAlignment="Right" Click="MirrorToggle_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- API -->
                    <Border x:Name="SecApi" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="API" Style="{StaticResource H2}"/>
                            <TextBlock Text="微软登录 Client ID（Azure 应用，需已获得 Minecraft API 权限）" Style="{StaticResource Sub}"/>
                            <TextBox x:Name="MsClientId" Margin="0,4,0,4" Tag="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" LostFocus="Any_Changed"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10" Text="去中心化：每个发行版 / 每个人都可以用自己申请的 ID，一个被封不影响别人。申请步骤见 docs/微软登录.md。"/>
                            <TextBlock Text="CurseForge API Key（可选）" Style="{StaticResource Sub}"/>
                            <TextBox x:Name="CfKey" Margin="0,4,0,4" Tag="留空则通过 MCIM 镜像访问 CurseForge" LostFocus="Any_Changed"/>
                            <TextBlock Style="{StaticResource Sub}" Text="在 console.curseforge.com 免费申请。填了以后官方源可用，镜像挂了也能搜 CurseForge。"/>
                        </StackPanel>
                    </Border>

                    <!-- 额外更新源与公钥 -->
                    <Border x:Name="SecUpdateAdvanced" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="额外更新源与公钥" Style="{StaticResource H2}"/>
                            <TextBlock Text="额外的更新源（每行一个 update.json 地址，可填自建镜像 / 社区维护地址）" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                            <TextBox x:Name="UpdateSources" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                                     Height="70" VerticalContentAlignment="Top" LostFocus="Any_Changed"/>
                            <Grid Margin="0,12,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="信任的发布者" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                <Button Grid.Column="1" Content="添加公钥" HorizontalAlignment="Right" Click="AddKey_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Sub}" Text="只有被这里的公钥签名的更新才会被安装。原作者不再维护时，可以添加你信任的社区维护者的公钥来继续接收更新。" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="KeyList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NestedItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Fingerprint}" FontFamily="{StaticResource FontFamily.Mono}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Origin}" Style="{StaticResource Sub}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="移除" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Click="RemoveKey_Click" Visibility="{Binding RemovableVis}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
