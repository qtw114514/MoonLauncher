<UserControl x:Class="OpenLauncher.UI.Pages.ProjectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OpenLauncher.UI">
    <DockPanel Margin="22,16,22,10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource Ghost}" Click="Back_Click" Margin="-8,0,6,0">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}"/>
            </Button>
            <TextBlock Text="资源详情" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,16,0" ClipToBounds="True" VerticalAlignment="Top">
                    <Image x:Name="Icon" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PTitle" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PMeta" Style="{StaticResource Sub}" Margin="0,3,0,6"/>
                    <TextBlock x:Name="PDesc" Style="{StaticResource Body}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="打开网页" Click="Web_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}" Margin="0,0,0,10" x:Name="DescCard" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <TextBlock Text="介绍" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="McmodLink" Content="在 MC 百科打开" Style="{StaticResource Ghost}" Visibility="Collapsed" Click="Mcmod_Click"/>
                        <Button x:Name="DescToggle" Content="展开" Style="{StaticResource Ghost}" Click="DescToggle_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ZhStatus" Text="正在查找中文介绍…" Style="{StaticResource Sub}" Margin="0,8,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="ZhPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="中文简介（来自 MC 百科）" Style="{StaticResource Sub}"/>
                    <TextBlock x:Name="ZhText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <ScrollViewer x:Name="DescScroll" MaxHeight="0" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="BodyText" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="FilesTitle" Text="选择要下载的文件" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="OnlyMatch" Style="{StaticResource Switch}" Content="只看适配当前筛选的" IsChecked="True" Click="OnlyMatch_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="TargetInfo" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid>
            <ListBox x:Name="Files" Style="{StaticResource CardList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding ReleaseTypeText}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding LoadersText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Published, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="下载" Style="{StaticResource Primary}" Padding="16,6" VerticalAlignment="Center" Click="Download_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="加载文件列表…" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <ProgressBar x:Name="StatusBar" IsIndeterminate="True" Width="200" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
