<UserControl x:Class="OpenLauncher.UI.Pages.InstancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:OpenLauncher.UI.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisLocal"/>
        <pages:ModErrorVisibilityConverter x:Key="ModErrorVis"/>
        <Style x:Key="ModActionButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModActionSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FileActionButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Margin.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="0"/>
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource Margin.HeaderBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Ghost}" Click="Back_Click" Margin="-8,0,8,0" VerticalAlignment="Top"
                    ToolTip="返回版本选择" AutomationProperties.Name="返回版本选择">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}"/>
            </Button>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock x:Name="Title" Text="版本设置" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="SubTitle" Style="{StaticResource Sub}" Margin="{StaticResource Margin.TextTop}"/>
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="{StaticResource Radius.Pill}" Padding="10,5" VerticalAlignment="Top">
                <TextBlock x:Name="StateText" Text="实例管理" Style="{StaticResource Sub}" Foreground="{DynamicResource Accent}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- 主区：当前实例的功能库，属于启动域子页面。 -->
            <Border Style="{StaticResource CardBox}" Margin="0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="实例管理" Style="{StaticResource H2}" Margin="10,4,0,8"/>
                        <RadioButton x:Name="TabOverview" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE946;" Content="概览" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSettings" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE713;" Content="全部设置" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabMods" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE74C;" Content="Mod" Checked="Tab_Checked"/>
                        <TextBlock x:Name="NonModdedHint" Style="{StaticResource Sub}" Margin="12,2,8,8" Visibility="Collapsed"
                                   Text="当前版本未识别到 Mod 加载器，Mod 管理不可用；其他实例功能仍可使用。"/>
                        <RadioButton x:Name="TabResource" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE8B9;" Content="资源包" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabShader" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE706;" Content="光影包" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSaves" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE909;" Content="存档" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabShots" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE722;" Content="截图" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabExport" GroupName="it" Style="{StaticResource SideNav}" Tag="&#xE898;" Content="导出整合包" Checked="Tab_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 从区：所选功能的详细内容。 -->
            <Grid Grid.Column="2">
                <!-- 概览 -->
                <ScrollViewer x:Name="PanelOverview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="版本信息" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="InfoText" Style="{StaticResource Body}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="实例操作" Style="{StaticResource H2}"/>
                                <WrapPanel>
                                    <Button Content="打开版本文件夹" Margin="0,0,8,8" Click="OpenDir_Click"/>
                                    <Button Content="打开游戏目录" Margin="0,0,8,8" Click="OpenGameDir_Click"/>
                                    <Button x:Name="CompleteBtn" Content="补全游戏文件" Margin="0,0,8,8" Click="Complete_Click"/>
                                    <Button Content="导出启动脚本" Margin="0,0,8,8" Click="ExportScript_Click"/>
                                    <Button x:Name="RenameBtn" Content="重命名" Margin="0,0,8,8" Click="Rename_Click"/>
                                    <Button Content="修改描述" Margin="0,0,8,8" Click="Describe_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="BusyNotice" Style="{StaticResource Sub}" Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                                           Text="游戏正在运行或启动准备中，补全、重命名、删除及文件修改已锁定。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="危险操作" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Sub}" Text="删除会把整个版本文件夹放进回收站（隔离版本的存档、Mod 也在里面）。" Margin="0,0,0,8"/>
                                <Button x:Name="DeleteBtn" Content="删除这个版本" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="Delete_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 全部实例设置 -->
                <ScrollViewer x:Name="PanelSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="游戏目录" Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="版本隔离" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ComboBox x:Name="Isolation" Grid.Column="1" SelectionChanged="Setting_Changed">
                                        <ComboBoxItem Content="跟随全局设置" Tag=""/>
                                        <ComboBoxItem Content="开启（存档、Mod 放在版本文件夹）" Tag="on"/>
                                        <ComboBoxItem Content="关闭（共用 .minecraft）" Tag="off"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource Sub}" Text="开启后这个版本的 mods、saves、config 都放在它自己的文件夹里，不同整合包互不干扰。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="Java 与内存" Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Java" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ComboBox x:Name="JavaBox" Grid.Column="1" SelectionChanged="Setting_Changed"/>
                                    <Button Grid.Column="2" Content="浏览…" Margin="8,0,0,0" Click="BrowseJava_Click"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="游戏内存" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ComboBox x:Name="MemMode" Grid.Column="1" SelectionChanged="Setting_Changed">
                                        <ComboBoxItem Content="跟随全局设置" Tag=""/>
                                        <ComboBoxItem Content="自动分配" Tag="auto"/>
                                        <ComboBoxItem Content="自定义" Tag="custom"/>
                                    </ComboBox>
                                </Grid>
                                <Grid x:Name="MemCustomRow" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MemSlider" Minimum="1024" Maximum="16384" TickFrequency="256" IsSnapToTickEnabled="True" Margin="0,0,16,0" ValueChanged="MemSlider_ValueChanged"/>
                                    <TextBlock x:Name="MemText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Body}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="启动选项" Style="{StaticResource H2}"/>
                                <TextBlock Text="游戏窗口标题（留空不修改，可用 {version}）" Style="{StaticResource Sub}"/>
                                <TextBox x:Name="TitleBox" Margin="0,4,0,10" LostFocus="Text_LostFocus"/>
                                <TextBlock Text="启动后自动进入服务器（如 mc.example.com:25565）" Style="{StaticResource Sub}"/>
                                <TextBox x:Name="ServerBox" Margin="0,4,0,10" LostFocus="Text_LostFocus"/>
                                <TextBlock Text="主界面左下角显示的版本类型文字" Style="{StaticResource Sub}"/>
                                <TextBox x:Name="VersionTypeBox" Margin="0,4,0,10" Tag="MoonLauncher" LostFocus="Text_LostFocus"/>
                                <TextBlock Text="额外 JVM 参数（留空使用全局设置）" Style="{StaticResource Sub}"/>
                                <TextBox x:Name="JvmBox" Margin="0,4,0,10" LostFocus="Text_LostFocus"/>
                                <TextBlock Text="额外游戏参数（留空使用全局设置）" Style="{StaticResource Sub}"/>
                                <TextBox x:Name="GameArgsBox" Margin="0,4,0,10" LostFocus="Text_LostFocus"/>
                                <CheckBox x:Name="SkipCheck" Style="{StaticResource Switch}" Content="启动前不检查文件完整性（更快，但文件坏了不会自动修复）" Click="Setting_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mod -->
                <DockPanel x:Name="PanelMods" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ModSearch" Tag="搜索已安装的 Mod" TextChanged="ModSearch_TextChanged"/>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button Content="打开文件夹" Margin="0,0,6,0" Click="OpenMods_Click"/>
                            <Button x:Name="CheckUpdatesBtn" Content="检查更新" Margin="0,0,6,0" Click="CheckUpdates_Click"/>
                            <Button x:Name="UpdateAllBtn" Content="全部更新" Margin="0,0,6,0" Click="UpdateAll_Click" Visibility="Collapsed"/>
                            <Button Content="下载 Mod" Style="{StaticResource Primary}" Click="DownloadMods_Click"/>
                        </WrapPanel>
                    </Grid>
                    <TextBlock x:Name="ModStats" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="2,0,0,8"/>
                    <Grid>
                        <ListBox x:Name="ModList" Style="{StaticResource CardList}" VirtualizingPanel.IsVirtualizing="True" AllowDrop="True" Drop="ModList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="7" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" ClipToBounds="True">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DisplayName}"/>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Version}" Style="{StaticResource Sub}" Margin="0,0,8,0"/>
                                                <Border Background="{DynamicResource OkSoft}" CornerRadius="4" Padding="5,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisLocal}}">
                                                    <TextBlock Text="有更新" FontSize="11" Foreground="{DynamicResource Ok}"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding FilePath}"/>
                                            <TextBlock Text="{Binding LoadError, StringFormat=坏 Mod：无法读取信息（{0}）}" Style="{StaticResource Sub}" Foreground="{DynamicResource Danger}"
                                                       Visibility="{Binding LoadError, Converter={StaticResource ModErrorVis}}" ToolTip="{Binding LoadError}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ModActionButton}" ToolTip="更新" Click="UpdateMod_Click" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisLocal}}">
                                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}"/>
                                            </Button>
                                            <CheckBox Style="{StaticResource ModActionSwitch}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="ToggleMod_Click" ToolTip="启用 / 禁用" Margin="6,0"/>
                                            <Button Style="{StaticResource ModActionButton}" ToolTip="删除（放进回收站）" Click="DeleteMod_Click">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModEmpty" Style="{StaticResource Body}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360" Margin="24" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>

                <!-- 文件夹类（资源包 / 光影 / 存档 / 截图） -->
                <DockPanel x:Name="PanelFiles" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="FilesHint" Style="{StaticResource Sub}"/>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button Content="打开文件夹" Margin="0,0,6,0" Click="OpenFiles_Click"/>
                            <Button x:Name="FilesDownload" Content="去下载" Style="{StaticResource Primary}" Click="FilesDownload_Click"/>
                        </WrapPanel>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="FileList" Style="{StaticResource CardList}" AllowDrop="True" Drop="FileList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/>
                                            <TextBlock Text="{Binding Info}" Style="{StaticResource Sub}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource FileActionButton}" VerticalAlignment="Center" ToolTip="删除（放进回收站）" Click="DeleteFile_Click">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="FilesEmpty" Style="{StaticResource Body}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360" Margin="24" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>

                <!-- 导出 -->
                <ScrollViewer x:Name="PanelExport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource CardBox}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="导出为 Modrinth 整合包（.mrpack）" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Body}" Text="能在 Modrinth 上找到的 Mod 只记录下载地址（文件小、合规），其他文件（配置、找不到来源的 Mod）打包进 overrides。导出的文件可以被本启动器、PCL、HMCL、Prism 等导入。" Margin="0,0,0,12"/>
                            <TextBlock Text="整合包名称" Style="{StaticResource Sub}"/>
                            <TextBox x:Name="PackName" Margin="0,4,0,10"/>
                            <TextBlock Text="整合包版本" Style="{StaticResource Sub}"/>
                            <TextBox x:Name="PackVersion" Text="1.0.0" Margin="0,4,0,10"/>
                            <CheckBox x:Name="PackSaves" Style="{StaticResource Switch}" Content="包含存档"/>
                            <Button Content="导出…" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Export_Click"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
