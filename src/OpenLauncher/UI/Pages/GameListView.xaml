<UserControl x:Class="OpenLauncher.UI.Pages.GameListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="22,18,22,14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="安装 Minecraft" Style="{StaticResource H1}"/>
                <TextBlock Text="选择版本与类型，安装前可配置加载器和目标位置。" Style="{StaticResource Sub}" Margin="0,2,12,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="Search" Tag="搜索版本号" Width="200" TextChanged="Filter_Changed"/>
                <Button Content="刷新" Margin="8,0,0,0" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}" Padding="12,6" Margin="0,0,0,10">
            <WrapPanel>
                <RadioButton x:Name="FRelease" GroupName="vt" Style="{StaticResource Pill}" Content="正式版" IsChecked="True" Checked="Filter_Changed"/>
                <RadioButton x:Name="FSnapshot" GroupName="vt" Style="{StaticResource Pill}" Content="快照版" Checked="Filter_Changed"/>
                <RadioButton x:Name="FOld" GroupName="vt" Style="{StaticResource Pill}" Content="远古版" Checked="Filter_Changed"/>
                <RadioButton x:Name="FFools" GroupName="vt" Style="{StaticResource Pill}" Content="愚人节版" Checked="Filter_Changed"/>
                <RadioButton x:Name="FAll" GroupName="vt" Style="{StaticResource Pill}" Content="全部" Checked="Filter_Changed"/>
            </WrapPanel>
        </Border>

        <Grid>
            <ListBox x:Name="List" Style="{StaticResource CardList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="List_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="{StaticResource Radius.Small}" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                <TextBlock Text="MC" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Id}" ToolTip="{Binding Id}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Sub}">
                                    <Run Text="{Binding TypeText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding DateText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="安装" Style="{StaticResource Primary}" Padding="16,6" VerticalAlignment="Center" Click="Install_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="Loading" Style="{StaticResource CardBox}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="LoadingText" Text="正在从官方获取版本列表…" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="220" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <Button x:Name="RetryVersions" Content="重试" Margin="0,10,0,0" Padding="18,5" HorizontalAlignment="Center" Visibility="Collapsed" Click="Refresh_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="EmptyState" Style="{StaticResource CardBox}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="没有匹配的 Minecraft 版本" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="当前关键词或版本类型没有结果，请修改搜索词或切换版本类型。" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
