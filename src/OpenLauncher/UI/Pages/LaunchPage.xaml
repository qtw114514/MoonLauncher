<UserControl x:Class="OpenLauncher.UI.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="LaunchLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LaunchRailColumn" Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏只承载启动上下文：账户、当前实例、启动按钮固定，实例列表只滚动自身。 -->
        <Grid Margin="0,16,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardBox}" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="AvatarFallback" Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="Avatar" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PlayerName" Text="未登录" Style="{StaticResource H2}" Margin="0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AccountType" Text="添加账户后即可启动" Style="{StaticResource Sub}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource Ghost}" MinHeight="40" Margin="0,8,0,0" Click="Accounts_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,6,0"/>
                            <TextBlock Text="切换 / 管理账户"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="InstanceCard" Grid.Row="1" Style="{StaticResource CardBox}" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentSoft}">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="21" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="当前实例" Style="{StaticResource Sub}"/>
                            <TextBlock x:Name="InstanceName" Text="尚未安装实例" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="InstanceDesc" Text="去下载页安装一个版本即可开始。" Style="{StaticResource Sub}" Margin="0,8,0,4" MaxHeight="38"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="切换" Style="{StaticResource Ghost}" MinHeight="40" Padding="4" Click="Versions_Click"/>
                        <Button Grid.Column="1" Content="设置" Style="{StaticResource Ghost}" MinHeight="40" Padding="4" Click="VersionSettings_Click"/>
                        <Button Grid.Column="2" Content="Mod" Style="{StaticResource Ghost}" MinHeight="40" Padding="4" Click="ManageMods_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="打开目录" Style="{StaticResource Ghost}" MinHeight="40" Padding="4" Click="OpenGameDir_Click"/>
                        <Button Grid.Column="1" Content="下载 Mod" Style="{StaticResource Ghost}" MinHeight="40" Padding="4" Click="DownloadMods_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="LaunchButton" Grid.Row="2" Style="{StaticResource Primary}" MinHeight="66" Click="Launch_Click" Padding="8,6">
                <StackPanel HorizontalAlignment="Center" MaxWidth="240">
                    <TextBlock x:Name="LaunchText" Text="启动游戏" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock x:Name="LaunchSub" Text="未选择实例" FontSize="11" HorizontalAlignment="Center" Foreground="#DDFFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                </StackPanel>
            </Button>

            <!-- 实例列表：虚拟化+回收，固定最大高度，只在自身内部滚动，不挤压上方启动按钮。 -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="实例列表" Style="{StaticResource Sub}" Foreground="{DynamicResource Accent}"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel x:Name="InstanceEmpty" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="当前游戏目录还没有实例，去下载页安装一个版本即可开始。" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                    <Button Content="去下载" Style="{StaticResource Ghost}" MinHeight="40" HorizontalAlignment="Center" Click="GoDownload_Click"/>
                </StackPanel>
                <ListBox x:Name="InstanceList" Grid.Row="1" Style="{StaticResource CardList}" MaxHeight="200"
                         SelectionChanged="InstanceList_SelectionChanged" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Id}"/>
                                <TextBlock Text="{Binding Desc}" Style="{StaticResource Sub}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Desc}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 右栏：状态、进度和日志始终优先于发现内容。 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,4,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="Greeting" Text="欢迎回来" Style="{StaticResource H1}"/>
                        <TextBlock Text="状态优先，发现随后。准备回到你的方块世界。" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,3" VerticalAlignment="Top" Margin="10,0,0,0">
                        <TextBlock Text="启动台" Foreground="{DynamicResource Text}" FontSize="11"/>
                    </Border>
                </Grid>

                <Border x:Name="StatusCard" Style="{StaticResource CardBox}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                            <TextBlock x:Name="StatusIcon" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Ok}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock x:Name="StatusTitle" Text="正在检查启动环境" Style="{StaticResource H2}" Margin="0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StatusDescription" Text="正在读取当前账户与实例。" Style="{StaticResource Sub}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LaunchProgressPanel" Style="{StaticResource CardBox}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LaunchStep" Text="正在启动…" Style="{StaticResource H2}" Margin="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button Grid.Column="1" Content="取消启动" Style="{StaticResource Ghost}" MinHeight="40" Margin="12,-6,-6,-6" Click="CancelLaunch_Click"/>
                        </Grid>
                        <ProgressBar x:Name="LaunchBar" Maximum="1" Margin="0,12,0,4"/>
                    </StackPanel>
                </Border>

                <Border x:Name="RunningCard" Style="{StaticResource CardBox}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RunningTitle" Text="游戏运行中" Style="{StaticResource H2}" Margin="0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="打开目录" Style="{StaticResource Ghost}" MinHeight="40" Click="OpenGameDir_Click"/>
                                <Button Content="结束游戏" Style="{StaticResource DangerButton}" Padding="12,5" Margin="6,0,0,0" Click="KillGame_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="GameLog" Margin="0,12,0,0" Height="190" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                 VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Card}"/>
                    </StackPanel>
                </Border>

                <!-- Hero：Minecraft 官网社区 RSS，只展示真实抓取结果；失败给明确错误与重试，绝不编造。
                     首条新闻以大图横幅呈现：优先文章 og:image，失败回退官网固定头图（非文章原图），失败再退玻璃/图标底。 -->
                <Border x:Name="NewsCard" Style="{StaticResource CardBox}" Padding="0">
                    <StackPanel>
                        <Grid x:Name="NewsHero" Height="{StaticResource Size.News.HeroHeight}" Visibility="Collapsed"
                              Cursor="Hand" MouseDown="NewsHero_Click">
                            <Border Background="{DynamicResource AccentSoft}">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="{StaticResource Size.Icon.Lg}"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="NewsHeroImage" Stretch="UniformToFill"/>
                            <Rectangle Fill="{DynamicResource HeroOverlay}" IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="{StaticResource Margin.Hero}">
                                <TextBlock x:Name="NewsHeroDate" Style="{StaticResource Sub}" Foreground="{DynamicResource Text2}"/>
                                <TextBlock x:Name="NewsHeroTitle" FontSize="{StaticResource Font.H2}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="46" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <TextBlock x:Name="NewsHeroDesc" Style="{StaticResource Sub}" Foreground="{DynamicResource Text2}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Margin="{StaticResource Margin.TextTop}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MINECRAFT · 官方新闻" Style="{StaticResource Sub}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                    <TextBlock Text="来自 Minecraft 官网社区 RSS" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="来源" Style="{StaticResource Ghost}" MinHeight="40" Margin="0,-7,0,0"
                                        ToolTip="打开 minecraft.net 官方新闻源" Click="NewsSource_Click"/>
                            </Grid>

                            <TextBlock x:Name="NewsLoading" Text="正在加载官方新闻…" Style="{StaticResource Sub}" Margin="0,14,0,0"/>
                            <StackPanel x:Name="NewsError" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock x:Name="NewsErrorText" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                <Button Content="重试" Style="{StaticResource Ghost}" MinHeight="40" HorizontalAlignment="Left"
                                        Margin="-8,8,0,-6" Click="NewsRetry_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="NewsItems" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 自定义主页保留原有 HomeUrl、错误提示和打开原网页能力。 -->
                <Border x:Name="HomeCard" Style="{StaticResource CardBox}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="自定义主页" Style="{StaticResource H2}"/>
                            <Button Content="打开原网页" Style="{StaticResource Ghost}" MinHeight="40" HorizontalAlignment="Right" Margin="0,-7,0,0" Click="OpenHome_Click"/>
                        </Grid>
                        <WebBrowser x:Name="HomeWeb" Height="240" Margin="0,10,0,0" LoadCompleted="HomeWeb_LoadCompleted" Loaded="HomeWeb_Loaded"/>
                        <TextBlock x:Name="HomeHint" Text="主页地址无效或加载失败，请检查 设置 → 个性化 里的网址" Style="{StaticResource Sub}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
