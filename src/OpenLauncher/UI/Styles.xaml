                        <Border x:Name="Indeterminate" Background="{TemplateBinding Foreground}" CornerRadius="{StaticResource Radius.Small}"
                                HorizontalAlignment="Left" Width="{StaticResource Size.Progress.IndeterminateWidth}" Visibility="Collapsed" Opacity="0.8"/>
